# Copy to .env and fill in. Never commit the real .env.

# LLM that reads CVs and judges requirements: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Same key, other models used in order when the one above hits its rate limit
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_ATTEMPTS=3
LLM_RETRY_WAIT_SECONDS=20

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Score weights (must total 1.0)
MUST_HAVE_WEIGHT=0.50
SHOULD_HAVE_WEIGHT=0.20
SEMANTIC_WEIGHT=0.15
LLM_FIT_WEIGHT=0.15
KNOCKOUT_SCORE_CAP=59

# HR Connect backend (same names as v1). The backend's Mf03Integration:BaseUrl points here.
HRCONNECT_BASE_URL=http://127.0.0.1:5000
# Must equal Mf03Integration__ServiceToken on the backend.
HRCONNECT_SERVICE_TOKEN=
HRCONNECT_VERIFY_SSL=true
SCORING_WORKER_COUNT=1
YEARS_TOLERANCE=0.25
LLM_TEMPERATURE=0
LLM_SEED=7

# Providers tried in order when LLM_PROVIDER fails (needs their keys), e.g. openai
LLM_FALLBACK_PROVIDERS=
