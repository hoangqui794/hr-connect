# Anthropic API key (create one at https://platform.claude.com). Never commit the real .env.
ANTHROPIC_API_KEY=

# Model that reads CVs and judges requirements. claude-opus-5-5 is the default;
# claude-haiku-5-5 is much cheaper and faster - compare both with tools/evaluate.py before choosing.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# EXPERIMENTAL weights, same defaults as v1 (must total 1.0)
MUST_HAVE_WEIGHT=0.50
SHOULD_HAVE_WEIGHT=0.20
SEMANTIC_WEIGHT=0.30
KNOCKOUT_SCORE_CAP=59
