# ==============================================================================
# HR Connect AI Matching Service (ai-service-v2 / Python FastAPI) — Template
# Copy this file to `.env` and fill in your credentials. Never commit `.env`!
# ==============================================================================

# 1. LLM Provider & Google Gemini Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback Gemini models tried in order when the primary model hits rate limits
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
LLM_EFFORT=medium
LLM_MAX_ATTEMPTS=3
LLM_RETRY_WAIT_SECONDS=20

# 2. Sentence-BERT Multilingual Embedding Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 3. Scoring Formula Weights (must sum to 1.0) & Must-Have Knockout Cap
MUST_HAVE_WEIGHT=0.50
SHOULD_HAVE_WEIGHT=0.20
SEMANTIC_WEIGHT=0.15
LLM_FIT_WEIGHT=0.15
KNOCKOUT_SCORE_CAP=59

# 4. HR Connect Backend Integration (Callback & Internal JD/CV Fetch)
# Must match the running HRConnect.Presentation base URL and Mf03Integration__ServiceToken
HRCONNECT_BASE_URL=http://127.0.0.1:5041
HRCONNECT_SERVICE_TOKEN=your_internal_service_token
HRCONNECT_VERIFY_SSL=false
SCORING_WORKER_COUNT=1
YEARS_TOLERANCE=0.25
LLM_TEMPERATURE=0
LLM_SEED=7
