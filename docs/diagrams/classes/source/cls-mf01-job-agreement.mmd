---
title: cls MF-01: Job, Review and Service Agreement
config:
  layout: elk
---
classDiagram
  direction LR
  class JobEndpoints {
    <<endpoint>>
    + MapJobEndpoints(app) : IEndpointRouteBuilder
    + CreateJob(cmd, sender) : Task<IResult>
    + SubmitJob(jobId, sender) : Task<IResult>
    + ApproveOrRejectJob(jobId, sender) : Task<IResult>
  }
  class ServiceAgreementEndpoints {
    <<endpoint>>
    + MapServiceAgreementEndpoints(app) : IEndpointRouteBuilder
    + CreateProposal(jobId, cmd) : Task<IResult>
    + RespondToAgreement(jobId, aid, body) : Task<IResult>
    + UploadSignedCopy(jobId, aid, file) : Task<IResult>
  }
  class VnPayPaymentEndpoints {
    <<endpoint>>
    + MapVnPayEndpoints(app) : IEndpointRouteBuilder
    + CreatePaymentUrl(cmd, sender) : Task<IResult>
    + HandleVnPayCallback(query, sender) : Task<IResult>
  }
  class CreateJobCommandHandler {
    <<handler>>
    - _jobs : IJobRepository
    - _accessPolicy : JobAccessPolicy
    + Handle(cmd, ct) : Task<JobDetailDto>
  }
  class ApproveJobCommandHandler {
    <<handler>>
    - _jobs : IJobRepository
    - _sourcingFinance : ISourcingFinanceService
    + Handle(cmd, ct) : Task<JobDetailDto>
  }
  class CreateServiceAgreementProposalCommandHandler {
    <<handler>>
    - _agreements : IServiceAgreementRepository
    - _pdfRenderer : IAgreementPdfRenderer
    + Handle(cmd, ct) : Task<ServiceAgreementDto>
  }
  class RespondToServiceAgreementCommandHandler {
    <<handler>>
    - _agreements : IServiceAgreementRepository
    - _jobs : IJobRepository
    + Handle(cmd, ct) : Task<ServiceAgreementDto>
  }
  class UploadSignedServiceAgreementCommandHandler {
    <<handler>>
    - _agreements : IServiceAgreementRepository
    - _storage : IFileStorageService
    + Handle(cmd, ct) : Task<ServiceAgreementDto>
  }
  class VnPayPaymentCommandHandlers {
    <<handler>>
    - _gateway : IVnPayGateway
    - _payments : IOnlinePaymentRepository
    + Handle(createCmd, ct) : Task<VnPayPaymentLinkResponse>
    + Handle(confirmCmd, ct) : Task<VnPayConfirmResult>
  }
  class JobAccessPolicy {
    <<policy>>
    + CanViewDetail(role, job) : bool
    + CanCandidateApply(job) : bool
    + CanAffiliateSubmit(job) : bool
    + CanManageJob(user, job) : bool
  }
  class SourcingFinanceService {
    <<service>>
    - _finance : IFinanceRepository
    + EnsureDepositAsync(job, ct) : Task<ServiceFee>
    + SettleAsync(job, userId, ct) : Task<ServiceFee>
  }
  class IAgreementPdfRenderer {
    <<interface>>
    + RenderAgreementPdf(agr, job, isSigned) : byte[]
  }
  class IFileStorageService {
    <<interface>>
    + UploadAsync(stream, key, type, ct) : Task
    + GetPresignedUrlAsync(key, expiry) : Task<string>
  }
  class IVnPayGateway {
    <<interface>>
    + IsEnabled : bool
    + CreatePaymentUrl(request) : string
    + ReadCallback(query) : VnPayCallbackData
  }
  class Job {
    <<entity>>
    + JobId : Guid
    + CompanyId : Guid
    + ServiceTypeId : Guid
    + Status : string
    + Quantity : int
    + FeeMultiplier : decimal?
    + WarrantyDays : int?
    + SourcingTarget : int?
    + CurrentServiceAgreementId : Guid?
    + ConcurrencyToken : Guid
    + ChangeStatus(newStatus, actorId, reason) : void
  }
  class JobRequirement {
    <<entity>>
    + JobRequirementId : Guid
    + JobId : Guid
    + RequirementType : string
    + Content : string
    + Weight : decimal
  }
  class ServiceAgreement {
    <<entity>>
    + ServiceAgreementId : Guid
    + JobId : Guid
    + Version : int
    + Status : string
    + FeeMultiplier : decimal?
    + SignedDocumentStorageKey : string?
    + DocumentSha256Hash : string
  }
  class JobPostingFee {
    <<entity>>
    + JobPostingFeeId : Guid
    + JobId : Guid
    + Amount : decimal
    + Status : string
    + PaymentReference : string?
  }
  JobEndpoints ..> CreateJobCommandHandler : sends
  JobEndpoints ..> ApproveJobCommandHandler : sends
  ServiceAgreementEndpoints ..> CreateServiceAgreementProposalCommandHandler : sends
  ServiceAgreementEndpoints ..> RespondToServiceAgreementCommandHandler : sends
  ServiceAgreementEndpoints ..> UploadSignedServiceAgreementCommandHandler : sends
  VnPayPaymentEndpoints ..> VnPayPaymentCommandHandlers : sends
  CreateJobCommandHandler ..> JobAccessPolicy : validates
  CreateJobCommandHandler --> Job : creates
  ApproveJobCommandHandler ..> SourcingFinanceService : uses
  ApproveJobCommandHandler --> Job : updates
  CreateServiceAgreementProposalCommandHandler ..> IAgreementPdfRenderer : renders
  CreateServiceAgreementProposalCommandHandler --> ServiceAgreement : creates
  RespondToServiceAgreementCommandHandler --> ServiceAgreement : updates
  UploadSignedServiceAgreementCommandHandler ..> IFileStorageService : uploads
  UploadSignedServiceAgreementCommandHandler --> ServiceAgreement : attaches copy
  VnPayPaymentCommandHandlers ..> IVnPayGateway : verifies
  VnPayPaymentCommandHandlers --> JobPostingFee : marks paid
  Job *-- JobRequirement : 1..*
  Job --> ServiceAgreement : 0..* agreements
  Job --> JobPostingFee : 0..* fees
  style JobEndpoints fill:#FFF4E5,stroke:#1B365D
  style ServiceAgreementEndpoints fill:#FFF4E5,stroke:#1B365D
  style VnPayPaymentEndpoints fill:#FFF4E5,stroke:#1B365D
  style CreateJobCommandHandler fill:#EAF2FB,stroke:#1B365D
  style ApproveJobCommandHandler fill:#EAF2FB,stroke:#1B365D
  style CreateServiceAgreementProposalCommandHandler fill:#EAF2FB,stroke:#1B365D
  style RespondToServiceAgreementCommandHandler fill:#EAF2FB,stroke:#1B365D
  style UploadSignedServiceAgreementCommandHandler fill:#EAF2FB,stroke:#1B365D
  style VnPayPaymentCommandHandlers fill:#EAF2FB,stroke:#1B365D
  style JobAccessPolicy fill:#F1F5F9,stroke:#1B365D
  style SourcingFinanceService fill:#EEF5EC,stroke:#1B365D
  style IAgreementPdfRenderer fill:#F3E8FF,stroke:#1B365D
  style IFileStorageService fill:#F3E8FF,stroke:#1B365D
  style IVnPayGateway fill:#F3E8FF,stroke:#1B365D
  style Job fill:#FFFFFF,stroke:#1B365D
  style JobRequirement fill:#FFFFFF,stroke:#1B365D
  style ServiceAgreement fill:#FFFFFF,stroke:#1B365D
  style JobPostingFee fill:#FFFFFF,stroke:#1B365D
