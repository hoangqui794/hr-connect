---
title: cls MF-02: Application, Referral, Consent and Attribution
config:
  layout: elk
---
classDiagram
  direction LR
  class JobApplicationEndpoints {
    <<endpoint>>
    + MapCandidateApplicationEndpoints(app) : void
    + ApplyJob(jobId, cmd, sender) : Task<IResult>
    + SubmitCandidate(jobId, cmd, sender) : Task<IResult>
  }
  class SubmissionConsentEndpoints {
    <<endpoint>>
    + MapSubmissionConsentEndpoints(app) : void
    + RespondConsent(cmd, sender) : Task<IResult>
    + ResendConsent(subId, sender) : Task<IResult>
  }
  class ApplyJobCommandHandler {
    <<handler>>
    - _submissions : ISubmissionRepository
    - _cvStorage : ICvStorageService
    - _scoringTrigger : IMf03ScoringTrigger
    + Handle(cmd, ct) : Task<ApplicationCreatedDto>
  }
  class SubmitCandidateCommandHandler {
    <<handler>>
    - _candidates : ICandidateRepository
    - _submissions : ISubmissionRepository
    - _cvStorage : ICvStorageService
    + Handle(cmd, ct) : Task<SubmissionResultDto>
  }
  class RespondSubmissionConsentCommandHandler {
    <<handler>>
    - _consents : ISubmissionConsentRepository
    - _acceptancePolicy : SubmissionAcceptancePolicy
    - _scoringTrigger : IMf03ScoringTrigger
    + Handle(cmd, ct) : Task<ConsentResponseDto>
  }
  class SubmissionAcceptancePolicy {
    <<policy>>
    - _applications : IApplicationRepository
    - _attributions : IAttributionRepository
    + AcceptAsync(submission, ct) : Task<Application>
    + GrantAttributionAsync(app, sub, ct) : Task
  }
  class ICvStorageService {
    <<interface>>
    + UploadCvPdfAsync(stream, name, ct) : Task<string>
    + UploadAffiliateCvPdfAsync(stream, ct) : Task<string>
    + DeleteCvAsync(fileUrl, ct) : Task
  }
  class IMf03ScoringTrigger {
    <<interface>>
    + TriggerScoringAsync(applicationId, ct) : Task
  }
  class SubmissionConsentExpiryService {
    <<service>>
    - _consents : ISubmissionConsentRepository
    + ExpireOverdueConsentsAsync(ct) : Task<int>
  }
  class Candidate {
    <<entity>>
    + CandidateId : Guid
    + FullName : string
    + Email : string
    + NormalizedEmail : string
    + NormalizedPhone : string?
    + ProfileVisibility : string
  }
  class CandidateCv {
    <<entity>>
    + CvId : Guid
    + CandidateId : Guid
    + SourceFileUrl : string?
    + ContentSha256 : string?
    + IsPrimary : bool
  }
  class Submission {
    <<entity>>
    + SubmissionId : Guid
    + JobId : Guid
    + CandidateId : Guid
    + Source : string
    + Status : string
    + DuplicateOfSubmissionId : Guid?
  }
  class SubmissionConsent {
    <<entity>>
    + ConsentId : Guid
    + SubmissionId : Guid
    + TokenHash : string
    + Status : string
    + ExpiresAt : DateTime
  }
  class Application {
    <<entity>>
    + ApplicationId : Guid
    + JobId : Guid
    + CandidateId : Guid
    + AcceptedSubmissionId : Guid
    + Status : string
    + ConcurrencyToken : Guid
  }
  class Attribution {
    <<entity>>
    + AttributionId : Guid
    + ApplicationId : Guid
    + AffiliateId : Guid
    + WinningSubmissionId : Guid
    + Status : string
  }
  class Dispute {
    <<entity>>
    + DisputeId : Guid
    + AttributionId : Guid?
    + DisputeType : string
    + Status : string
    + Resolution : string?
  }
  JobApplicationEndpoints ..> ApplyJobCommandHandler : sends
  JobApplicationEndpoints ..> SubmitCandidateCommandHandler : sends
  SubmissionConsentEndpoints ..> RespondSubmissionConsentCommandHandler : sends
  ApplyJobCommandHandler ..> SubmissionAcceptancePolicy : uses
  ApplyJobCommandHandler ..> ICvStorageService : stores CV
  ApplyJobCommandHandler ..> IMf03ScoringTrigger : queues AI
  SubmitCandidateCommandHandler ..> ICvStorageService : stores CV
  SubmitCandidateCommandHandler --> Submission : creates
  SubmitCandidateCommandHandler --> SubmissionConsent : creates
  RespondSubmissionConsentCommandHandler ..> SubmissionAcceptancePolicy : accepts
  RespondSubmissionConsentCommandHandler ..> IMf03ScoringTrigger : queues AI
  SubmissionConsentExpiryService --> SubmissionConsent : expires
  Candidate *-- CandidateCv : 0..*
  Candidate --> Submission : 0..*
  Submission --> SubmissionConsent : 0..1
  SubmissionAcceptancePolicy --> Application : creates
  Application --> Attribution : 0..1
  Attribution --> Dispute : 0..*
  style JobApplicationEndpoints fill:#FFF4E5,stroke:#1B365D
  style SubmissionConsentEndpoints fill:#FFF4E5,stroke:#1B365D
  style ApplyJobCommandHandler fill:#EAF2FB,stroke:#1B365D
  style SubmitCandidateCommandHandler fill:#EAF2FB,stroke:#1B365D
  style RespondSubmissionConsentCommandHandler fill:#EAF2FB,stroke:#1B365D
  style SubmissionAcceptancePolicy fill:#F1F5F9,stroke:#1B365D
  style ICvStorageService fill:#F3E8FF,stroke:#1B365D
  style IMf03ScoringTrigger fill:#F3E8FF,stroke:#1B365D
  style SubmissionConsentExpiryService fill:#EEF5EC,stroke:#1B365D
  style Candidate fill:#FFFFFF,stroke:#1B365D
  style CandidateCv fill:#FFFFFF,stroke:#1B365D
  style Submission fill:#FFFFFF,stroke:#1B365D
  style SubmissionConsent fill:#FFFFFF,stroke:#1B365D
  style Application fill:#FFFFFF,stroke:#1B365D
  style Attribution fill:#FFFFFF,stroke:#1B365D
  style Dispute fill:#FFFFFF,stroke:#1B365D
