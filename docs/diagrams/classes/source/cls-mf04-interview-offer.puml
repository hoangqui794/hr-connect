@startuml cls-mf04-interview-offer
title cls MF-04: Interview, Offer and Placement
left to right direction
skinparam classAttributeIconSize 0
class InterviewEndpoints <<endpoint>> {
  + MapInterviewEndpoints(app) : void
  + ScheduleInterview(appId, cmd) : Task<IResult>
  + RecordResult(id, cmd, sender) : Task<IResult>
}
class RecruitmentEndpoints <<endpoint>> {
  + MapRecruitmentEndpoints(app) : void
  + ManageOffer(appId, cmd) : Task<IResult>
  + ConfirmStartWork(appId, cmd) : Task<IResult>
  + ReconcilePlacement(id, cmd) : Task<IResult>
}
class ScheduleInterviewCommandHandler <<handler>> {
  - _interviews : IInterviewRepository
  - _participantPolicy : InterviewParticipantPolicy
  --
  + Handle(cmd, ct) : Task<InterviewDto>
}
class RecordInterviewResultCommandHandler <<handler>> {
  - _interviews : IInterviewRepository
  - _applications : IApplicationRepository
  --
  + Handle(cmd, ct) : Task<InterviewDto>
}
class SendOfferCommandHandler <<handler>> {
  - _offers : IOfferRepository
  - _salaryPolicy : OfferSalaryPolicy
  --
  + Handle(cmd, ct) : Task<OfferDto>
}
class RespondToOfferCommandHandler <<handler>> {
  - _offers : IOfferRepository
  - _applications : IApplicationRepository
  --
  + Handle(cmd, ct) : Task<OfferDto>
}
class ConfirmStartWorkCommandHandler <<handler>> {
  - _placements : IPlacementRepository
  - _financeService : IPlacementFinanceService
  --
  + Handle(cmd, ct) : Task<PlacementDto>
}
class ReconcilePlacementCommandHandler <<handler>> {
  - _reconciliations : IPlacementReconciliationRepository
  - _finance : IFinanceRepository
  --
  + Handle(cmd, ct) : Task<ReconciliationDto>
}
class ResolveFlaggedReconciliationCommandHandler <<handler>> {
  - _reconciliations : IPlacementReconciliationRepository
  --
  + Handle(cmd, ct) : Task<ReconciliationDto>
}
class InterviewParticipantPolicy <<policy>> {
  + EnsureCompanyMembersAsync(ids, cid) : Task
}
class OfferSalaryPolicy <<policy>> {
  + EnsureReadyForSending(offer, job) : void
  + CalculateMonthlyGrossSalary(offer) : decimal
}
class OfferExpiryService <<service>> {
  - _offers : IOfferRepository
  --
  + ExpireOverdueOffersAsync(ct) : Task<int>
}
interface IPlacementFinanceService <<interface>> {
  + InitializeAsync(placement, ctx, ct) : Task
}
class Interview <<entity>> {
  + InterviewId : Guid
  + ApplicationId : Guid
  + InterviewRound : int
  + ScheduledAt : DateTime
  + Status : string
  + Result : string?
}
class Application <<entity>> {
  + ApplicationId : Guid
  + JobId : Guid
  + Status : string
  + PlannedStartDate : DateOnly?
  + ConcurrencyToken : Guid
}
class Offer <<entity>> {
  + OfferId : Guid
  + ApplicationId : Guid
  + OfferVersion : int
  + Salary : decimal
  + SalaryBasis : string
  + ExpiryDate : DateOnly
  + Status : string
}
class Placement <<entity>> {
  + PlacementId : Guid
  + ApplicationId : Guid
  + ActualStartDate : DateOnly
  + Status : string
  + ReplacementSlotId : Guid?
}
class PlacementReconciliation <<entity>> {
  + ReconciliationId : Guid
  + PlacementId : Guid?
  + ClaimedOutcome : string
  + Status : string
  + ResolutionAction : string?
}
InterviewEndpoints ..> ScheduleInterviewCommandHandler : sends
InterviewEndpoints ..> RecordInterviewResultCommandHandler : sends
RecruitmentEndpoints ..> SendOfferCommandHandler : sends
RecruitmentEndpoints ..> RespondToOfferCommandHandler : sends
RecruitmentEndpoints ..> ConfirmStartWorkCommandHandler : sends
RecruitmentEndpoints ..> ReconcilePlacementCommandHandler : sends
ScheduleInterviewCommandHandler ..> InterviewParticipantPolicy : validates
ScheduleInterviewCommandHandler --> Interview : creates
RecordInterviewResultCommandHandler --> Interview : updates
SendOfferCommandHandler ..> OfferSalaryPolicy : validates
SendOfferCommandHandler --> Offer : sends
RespondToOfferCommandHandler --> Offer : updates
OfferExpiryService --> Offer : expires
ConfirmStartWorkCommandHandler ..> IPlacementFinanceService : initializes
ConfirmStartWorkCommandHandler --> Placement : creates
ConfirmStartWorkCommandHandler --> PlacementReconciliation : opens pending
ReconcilePlacementCommandHandler --> PlacementReconciliation : verifies
ResolveFlaggedReconciliationCommandHandler --> PlacementReconciliation : resolves
Application *-- Interview : 0..*
Application *-- Offer : 0..*
Application --> Placement : 0..1
PlacementReconciliation --> Placement : 0..1
@enduml
