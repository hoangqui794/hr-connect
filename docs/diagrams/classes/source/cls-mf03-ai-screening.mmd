---
title: cls MF-03: AI Matching and Screening
config:
  layout: elk
---
classDiagram
  direction LR
  class AiIntegrationEndpoints {
    <<endpoint>>
    + MapAiIntegrationEndpoints(app) : void
    + ReceiveAiResult(dto, sender) : Task<IResult>
    + GetJobDescription(jobId, sender) : Task<IResult>
  }
  class RecruitmentEndpoints {
    <<endpoint>>
    + MapRecruitmentEndpoints(app) : void
    + StartScreening(jobId, appId) : Task<IResult>
    + UpdateScreeningStatus(jobId, appId, cmd) : Task<IResult>
  }
  class SourcingDeliveryEndpoints {
    <<endpoint>>
    + MapSourcingDeliveryEndpoints(app) : void
    + DeliverCvToClient(jobId, cmd) : Task<IResult>
    + DecideDeliveredCv(id, cmd) : Task<IResult>
  }
  class RetryAiScoringCommandHandler {
    <<handler>>
    - _scoringTrigger : IMf03ScoringTrigger
    - _applications : IApplicationRepository
    + Handle(cmd, ct) : Task<AiMatchResultDto>
  }
  class UpdateApplicationScreeningStatusCommandHandler {
    <<handler>>
    - _applications : IApplicationRepository
    - _screeningPolicy : ScreeningPolicy
    - _concurrencyGuard : Mf04ConcurrencyGuard
    + Handle(cmd, ct) : Task<ApplicationStatusDto>
  }
  class SourcingDeliveryCommandHandlers {
    <<handler>>
    - _deliveries : ISourcingDeliveryRepository
    - _sourcingFinance : ISourcingFinanceService
    + Handle(deliverCmd, ct) : Task<SourcingDeliveryDto>
    + Handle(decideCmd, ct) : Task<SourcingDeliveryDto>
    + Handle(replaceCmd, ct) : Task<SourcingDeliveryDto>
  }
  class IMf03ScoringTrigger {
    <<interface>>
    + TriggerScoringAsync(applicationId, ct) : Task
  }
  class Mf03ScoringTrigger {
    <<service>>
    - _aiResults : IAiMatchResultRepository
    + TriggerScoringAsync(applicationId, ct) : Task
  }
  class Mf03ScoringDispatcher {
    <<worker>>
    - _aiClient : IHrConnectAiClient
    - _aiResults : IAiMatchResultRepository
    + DispatchBatchAsync(ct) : Task<int>
  }
  class ScreeningPolicy {
    <<policy>>
    + CanScreen(role, serviceTypeCode) : bool
    + ValidateTransition(from, to) : void
  }
  class Mf04ConcurrencyGuard {
    <<policy>>
    + EnsureMatches(expected, actual) : void
  }
  class SourcingAutoAcceptService {
    <<service>>
    - _deliveries : ISourcingDeliveryRepository
    + AutoAcceptOverdueAsync(ct) : Task<int>
  }
  class AiMatchResult {
    <<entity>>
    + AiMatchResultId : Guid
    + ApplicationId : Guid
    + AttemptNo : int
    + Status : string
    + MatchScore : decimal?
    + MatchTier : string?
    + MustHaveResult : string?
    + FailureCode : string?
  }
  class MatchTierConfig {
    <<entity>>
    + MatchTierConfigId : Guid
    + TierCode : string
    + MinScore : decimal
    + MaxScore : decimal
    + ColorCode : string
  }
  class Application {
    <<entity>>
    + ApplicationId : Guid
    + JobId : Guid
    + Status : string
    + StatusReasonCode : string?
    + ConcurrencyToken : Guid
  }
  class SourcingDelivery {
    <<entity>>
    + SourcingDeliveryId : Guid
    + JobId : Guid
    + ApplicationId : Guid
    + Status : string
    + ReviewDueAt : DateTime
    + RejectReasonCode : string?
  }
  AiIntegrationEndpoints --> AiMatchResult : completes callback
  RecruitmentEndpoints ..> RetryAiScoringCommandHandler : sends
  RecruitmentEndpoints ..> UpdateApplicationScreeningStatusCommandHandler : sends
  SourcingDeliveryEndpoints ..> SourcingDeliveryCommandHandlers : sends
  RetryAiScoringCommandHandler ..> IMf03ScoringTrigger : triggers
  Mf03ScoringTrigger ..|> IMf03ScoringTrigger
  Mf03ScoringTrigger --> AiMatchResult : creates PENDING
  Mf03ScoringDispatcher --> AiMatchResult : dispatches
  AiMatchResult ..> MatchTierConfig : resolves tier
  UpdateApplicationScreeningStatusCommandHandler ..> ScreeningPolicy : checks
  UpdateApplicationScreeningStatusCommandHandler ..> Mf04ConcurrencyGuard : guards
  UpdateApplicationScreeningStatusCommandHandler --> Application : updates status
  Application *-- AiMatchResult : 0..*
  Application --> SourcingDelivery : 0..*
  SourcingDeliveryCommandHandlers --> SourcingDelivery : manages
  SourcingAutoAcceptService --> SourcingDelivery : auto-accepts
  style AiIntegrationEndpoints fill:#FFF4E5,stroke:#1B365D
  style RecruitmentEndpoints fill:#FFF4E5,stroke:#1B365D
  style SourcingDeliveryEndpoints fill:#FFF4E5,stroke:#1B365D
  style RetryAiScoringCommandHandler fill:#EAF2FB,stroke:#1B365D
  style UpdateApplicationScreeningStatusCommandHandler fill:#EAF2FB,stroke:#1B365D
  style SourcingDeliveryCommandHandlers fill:#EAF2FB,stroke:#1B365D
  style IMf03ScoringTrigger fill:#F3E8FF,stroke:#1B365D
  style Mf03ScoringTrigger fill:#EEF5EC,stroke:#1B365D
  style Mf03ScoringDispatcher fill:#EEF5EC,stroke:#1B365D
  style ScreeningPolicy fill:#F1F5F9,stroke:#1B365D
  style Mf04ConcurrencyGuard fill:#F1F5F9,stroke:#1B365D
  style SourcingAutoAcceptService fill:#EEF5EC,stroke:#1B365D
  style AiMatchResult fill:#FFFFFF,stroke:#1B365D
  style MatchTierConfig fill:#FFFFFF,stroke:#1B365D
  style Application fill:#FFFFFF,stroke:#1B365D
  style SourcingDelivery fill:#FFFFFF,stroke:#1B365D
