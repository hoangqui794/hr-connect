---
title: MF-03 · AI matching and screening
config:
  layout: elk
---
classDiagram
  direction LR
  class AiIntegrationEndpoints {
    <<endpoint>>
    +POST /internal/ai-results
    +GET /internal/jobs/‹id›/jd
  }
  class RecruitmentEndpoints {
    <<endpoint>>
    +POST /jobs/‹jid›/applications/‹aid›/start-screening
    +PATCH /jobs/‹jid›/applications/‹aid›/status
  }
  class Mf03ScoringTrigger {
    <<service>>
    +TriggerScoringAsync()
  }
  class Mf03ScoringDispatcher {
    <<worker>>
    +DispatchBatchAsync()
    +retry with exponential back-off
  }
  class HRConnectClient {
    <<service>>
    +calls AI service /score
  }
  class RetryAiScoringCommand {
    <<handler>>
    +Handle(applicationId)
  }
  class UpdateApplicationScreeningStatusCommandHandler {
    <<handler>>
    +Handle(SHORTLISTED | BACKUP | REJECTED)
  }
  class ScreeningPolicy {
    <<policy>>
    +CanScreen(role, serviceType)
  }
  class Mf04ConcurrencyGuard {
    <<policy>>
    +EnsureMatches(token)
  }
  class SourcingDeliveryHandlers {
    <<handler>>
    +Deliver · Decide · Replace · ReviewRejection
  }
  class SourcingAutoAcceptService {
    <<service>>
    +AutoAcceptAsync()
  }
  class AiMatchResult {
    <<entity>>
    +AttemptNo · Status
    +MatchScore · MatchTier
    +MustHaveResult · ShouldHaveResult
    +FailureCode
  }
  class MatchTierConfig {
    <<entity>>
    +TierCode · MinScore · MaxScore
    +ColorCode
  }
  class Application {
    <<entity>>
    +Status · StatusReasonCode
    +ConcurrencyToken
  }
  class SourcingDelivery {
    <<entity>>
    +Status · ReviewDueAt
    +RejectReasonCode · ReplacedByDeliveryId
  }
  class IMf03ScoringTrigger {
    <<interface>>
    +TriggerScoringAsync()
  }
  Mf03ScoringTrigger ..|> IMf03ScoringTrigger
  Mf03ScoringTrigger --> AiMatchResult : creates PENDING
  Mf03ScoringDispatcher ..> HRConnectClient
  Mf03ScoringDispatcher --> AiMatchResult : PROCESSING / FAILED
  AiIntegrationEndpoints --> AiMatchResult : COMPLETED
  RetryAiScoringCommand ..> Mf03ScoringTrigger
  AiMatchResult ..> MatchTierConfig : tier by score
  RecruitmentEndpoints ..> UpdateApplicationScreeningStatusCommandHandler : sends
  UpdateApplicationScreeningStatusCommandHandler ..> ScreeningPolicy
  UpdateApplicationScreeningStatusCommandHandler ..> Mf04ConcurrencyGuard
  UpdateApplicationScreeningStatusCommandHandler --> Application : updates
  Application --> AiMatchResult : 0..*
  SourcingDeliveryHandlers --> SourcingDelivery
  SourcingAutoAcceptService --> SourcingDelivery : AUTO_ACCEPTED
  Application --> SourcingDelivery : 0..*
  style AiIntegrationEndpoints fill:#FFF4E5,stroke:#1B365D
  style RecruitmentEndpoints fill:#FFF4E5,stroke:#1B365D
  style Mf03ScoringTrigger fill:#EEF5EC,stroke:#1B365D
  style Mf03ScoringDispatcher fill:#EEF5EC,stroke:#1B365D
  style HRConnectClient fill:#EEF5EC,stroke:#1B365D
  style RetryAiScoringCommand fill:#EAF2FB,stroke:#1B365D
  style UpdateApplicationScreeningStatusCommandHandler fill:#EAF2FB,stroke:#1B365D
  style ScreeningPolicy fill:#F5F5F5,stroke:#1B365D
  style Mf04ConcurrencyGuard fill:#F5F5F5,stroke:#1B365D
  style SourcingDeliveryHandlers fill:#EAF2FB,stroke:#1B365D
  style SourcingAutoAcceptService fill:#EEF5EC,stroke:#1B365D
  style AiMatchResult fill:#FFFFFF,stroke:#1B365D
  style MatchTierConfig fill:#FFFFFF,stroke:#1B365D
  style Application fill:#FFFFFF,stroke:#1B365D
  style SourcingDelivery fill:#FFFFFF,stroke:#1B365D
  style IMf03ScoringTrigger fill:#F3E8FF,stroke:#1B365D
