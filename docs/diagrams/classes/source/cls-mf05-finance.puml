@startuml cls-mf05-finance
title cls MF-05: Warranty, Service Fee, Commission and Payout
left to right direction
skinparam classAttributeIconSize 0
class FinanceEndpoints <<endpoint>> {
  + MapFinanceEndpoints(app) : void
  + RecordServiceFeePayment(id, cmd) : Task<IResult>
  + ApproveCommission(id, cmd) : Task<IResult>
  + RecordPayout(id, cmd) : Task<IResult>
}
class WarrantyEndpoints <<endpoint>> {
  + MapWarrantyEndpoints(app) : void
  + ReportResignation(id, cmd) : Task<IResult>
  + ResolveResignation(id, cmd) : Task<IResult>
}
class WarrantyProgressWorker <<worker>> {
  - _progressService : WarrantyProgressService
  --
  # ExecuteAsync(stoppingToken) : Task
}
class SettlementCommandHandlers <<handler>> {
  - _finance : IFinanceRepository
  - _sourcingFinance : ISourcingFinanceService
  --
  + Handle(recordFeeCmd, ct) : Task<ServiceFeePaymentResponse>
  + Handle(approveCommCmd, ct) : Task<CommissionActionResponse>
  + Handle(adjustCommCmd, ct) : Task<CommissionActionResponse>
  + Handle(recordPayoutCmd, ct) : Task<PayoutResponse>
}
class ReportResignationCommandHandler <<handler>> {
  - _finance : IFinanceRepository
  - _companyUsers : ICompanyUserRepository
  --
  + Handle(cmd, ct) : Task<WarrantyClaimResponse>
}
class ResolveResignationCommandHandler <<handler>> {
  - _finance : IFinanceRepository
  - _settings : IAdminBusinessSettings
  --
  + Handle(cmd, ct) : Task<WarrantyClaimResponse>
}
class WarrantyProgressService <<service>> {
  - _finance : IFinanceRepository
  --
  + CompleteWarrantyAsync(ct) : Task<int>
  + MarkServiceFeeDueAsync(ct) : Task<int>
  + MarkServiceFeeOverdueAsync(ct) : Task<int>
  + ExpireReplacementSlotAsync(ct) : Task<int>
}
interface IPlacementFinanceService <<interface>> {
  + InitializeAsync(placement, ctx, ct) : Task
}
class PlacementFinanceService <<service>> {
  - _finance : IFinanceRepository
  - _rules : ICommissionRuleRepository
  --
  + InitializeAsync(placement, ctx, ct) : Task
  + CalculateCommission(rule, fee) : decimal
}
class SourcingFinanceService <<service>> {
  - _finance : IFinanceRepository
  --
  + EnsureDepositAsync(job, ct) : Task<ServiceFee>
  + OnDeliveryCountedAsync(delivery, ct) : Task
  + SettleAsync(job, actorId, ct) : Task<ServiceFee>
}
class AffiliateCommissionHoldService <<service>> {
  - _finance : IFinanceRepository
  --
  + HoldUnpaidForLockedAffiliateAsync(id, ct) : Task
}
class CommissionRule <<entity>> {
  + CommissionRuleId : Guid
  + ServiceTypeId : Guid
  + RateType : string
  + RateValue : decimal
  + WarrantyRequired : bool
}
class ServiceFee <<entity>> {
  + ServiceFeeId : Guid
  + PlacementId : Guid?
  + Kind : string
  + Amount : decimal
  + DueDate : DateOnly
  + Status : string
}
class ReplacementSlot <<entity>> {
  + ReplacementSlotId : Guid
  + OriginalPlacementId : Guid
  + ServiceFeeId : Guid
  + Status : string
  + ExpiresAt : DateTime?
}
class Warranty <<entity>> {
  + WarrantyId : Guid
  + PlacementId : Guid
  + StartDate : DateOnly
  + EndDate : DateOnly
  + Status : string
}
class Commission <<entity>> {
  + CommissionId : Guid
  + AttributionId : Guid
  + BaseAmount : decimal
  + Amount : decimal
  + Status : string
}
class CommissionAdjustment <<entity>> {
  + CommissionAdjustmentId : Guid
  + CommissionId : Guid
  + OldAmount : decimal
  + NewAmount : decimal
  + Reason : string
}
class Payout <<entity>> {
  + PayoutId : Guid
  + CommissionId : Guid
  + Amount : decimal
  + TransactionReference : string?
  + Status : string
  + AttemptNo : int
}
FinanceEndpoints ..> SettlementCommandHandlers : sends
WarrantyEndpoints ..> ReportResignationCommandHandler : sends
WarrantyEndpoints ..> ResolveResignationCommandHandler : sends
WarrantyProgressWorker ..> WarrantyProgressService : runs daily
PlacementFinanceService ..|> IPlacementFinanceService
PlacementFinanceService --> ServiceFee : creates
PlacementFinanceService --> Warranty : creates
PlacementFinanceService --> Commission : creates
PlacementFinanceService ..> CommissionRule : reads
SourcingFinanceService --> ServiceFee : deposit / settlement
AffiliateCommissionHoldService --> Commission : holds
SettlementCommandHandlers --> ServiceFee : marks paid
SettlementCommandHandlers --> Commission : approves / adjusts
SettlementCommandHandlers --> Payout : records
ReportResignationCommandHandler --> Warranty : marks claimed
ResolveResignationCommandHandler --> Warranty : voids / restores
ResolveResignationCommandHandler --> ReplacementSlot : opens slot
WarrantyProgressService --> Warranty : completes
WarrantyProgressService --> ServiceFee : marks due/overdue
ServiceFee --> ReplacementSlot : 0..*
Commission *-- CommissionAdjustment : 0..*
Commission *-- Payout : 0..*
@enduml
