@startuml pkg-hr-connect
title HR Connect – Package Diagram (UML 2.5)
skinparam packageStyle folder
skinparam shadowing false
left to right direction

package "HRConnect-FE" as FE {
  package "app · routes" {}
  package "pages · features" {}
  package "components" {}
  package "services · stores · hooks" {}
}

package "HRConnect.Presentation" as PRES {
  package "Endpoints (V1, Internal)" {}
  package "Hubs (SignalR)" {}
  package "Authorization · Middleware" {}
}

package "HRConnect.Application" as APP {
  package "Features (Auth, MF-01..MF-05)" {}
  package "Common (Interfaces, Policies, Models)" {}
}

package "HRConnect.Domain" as DOM {
  package "Entities (72)" {}
  package "Constants (States, Codes)" {}
}

package "HRConnect.Infrastructure" as INF {
  package "Persistence · Repositories" {}
  package "Authentication (JWT)" {}
  package "Services (R2, Resend, VNPay, AI Client)" {}
}

package "ai-service-v2" as AI {
  package "api · pipeline" {}
  package "documents · semantic · llm" {}
}

FE ..> PRES : <<use>>
PRES ..> APP : <<use>>
PRES ..> INF : <<use>>
APP ..> DOM : <<import>>
INF ..> APP : <<use>>
INF ..> DOM : <<import>>
INF ..> AI : <<use>>
@enduml
