<mxfile host="app.diagrams.net"><diagram id="arch-overview" name="System Architecture Overview"><mxGraphModel dx="1660" dy="860" grid="1" gridSize="10" page="1" pageWidth="1660" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="HR Connect — System Architecture Overview" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="900" height="34" as="geometry"/></mxCell><mxCell id="tier_actors" value="1. USERS &amp; ROLES" style="swimlane;startSize=38;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#475569;swimlaneFillColor=#F8FAFC;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#334155;rounded=1;arcSize=5;collapsible=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="62" width="230" height="760" as="geometry"/></mxCell><mxCell id="tier_client" value="2. PRESENTATION TIER (Frontend SPA)" style="swimlane;startSize=38;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#2563EB;swimlaneFillColor=#EFF6FF;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#1E3A8A;rounded=1;arcSize=5;collapsible=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="62" width="310" height="760" as="geometry"/></mxCell><mxCell id="tier_backend" value="3. APPLICATION &amp; AI TIER (Core Services)" style="swimlane;startSize=38;html=1;whiteSpace=wrap;fillColor=#F0FDFA;strokeColor=#0D9488;swimlaneFillColor=#F0FDFA;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#134E4A;rounded=1;arcSize=5;collapsible=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="62" width="470" height="760" as="geometry"/></mxCell><mxCell id="tier_data" value="4. DATA &amp; EXTERNAL SERVICES TIER" style="swimlane;startSize=38;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#D97706;swimlaneFillColor=#FFFBEB;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#92400E;rounded=1;arcSize=5;collapsible=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="62" width="370" height="760" as="geometry"/></mxCell><mxCell id="act_ext" value="👤 &lt;b style=&quot;font-size:15px;&quot;&gt;Candidate &amp; Guest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569;&quot;&gt;Job Search · Self-Apply&lt;br&gt;Consent · Interview &amp; Offer&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="190" height="105" as="geometry"/></mxCell><mxCell id="act_part" value="🤝 &lt;b style=&quot;font-size:15px;&quot;&gt;Client &amp; Affiliate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569;&quot;&gt;Job Request · CV Referral&lt;br&gt;Agreement · Fee &amp; Payout&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="190" height="105" as="geometry"/></mxCell><mxCell id="act_int" value="🛡️ &lt;b style=&quot;font-size:15px;&quot;&gt;Internal HR &amp; Admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569;&quot;&gt;Job Approval · Screening&lt;br&gt;Sourcing · Finance &amp; Audit&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="190" height="105" as="geometry"/></mxCell><mxCell id="fe_spa" value="💻 &lt;b style=&quot;font-size:16px;color:#1E3A8A;&quot;&gt;HRConnect Web App&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#2563EB;&quot;&gt;(React 19 + TypeScript + Vite)&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#BFDBFE&quot;&gt;&lt;font style=&quot;font-size:13px;color:#1E293B;&quot;&gt;• Role-Based Portals &amp; Guards&lt;br&gt;• Ant Design 5 + Tailwind CSS&lt;br&gt;• Zustand State &amp; i18next (VI/EN)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.8;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="345" y="190" width="260" height="210" as="geometry"/></mxCell><mxCell id="fe_comm" value="🔌 &lt;b style=&quot;font-size:15px;color:#1E3A8A;&quot;&gt;Client Communication&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#BFDBFE&quot;&gt;&lt;font style=&quot;font-size:13px;color:#1E293B;&quot;&gt;• &lt;b&gt;Axios HTTP:&lt;/b&gt; REST + JWT Auth&lt;br&gt;• &lt;b&gt;SignalR Client:&lt;/b&gt; Real-time Push&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.8;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="345" y="510" width="260" height="150" as="geometry"/></mxCell><mxCell id="be_api" value="⚙️ &lt;b style=&quot;font-size:16px;color:#134E4A;&quot;&gt;HRConnect Backend API (.NET 8)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F766E;&quot;&gt;(Clean Architecture + MediatR CQRS)&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#99F6E4&quot;&gt;&lt;font style=&quot;font-size:13px;color:#1E293B;&quot;&gt;• &lt;b&gt;Presentation:&lt;/b&gt; Minimal APIs, SignalR Hub, RBAC&lt;br&gt;• &lt;b&gt;Application:&lt;/b&gt; CQRS Handlers, Validators, Policies&lt;br&gt;• &lt;b&gt;Domain:&lt;/b&gt; Core Entities, State Machines &amp; Rules&lt;br&gt;• &lt;b&gt;Infrastructure:&lt;/b&gt; EF Core 8, JWT, PDF &amp; Adapters&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.8;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=10;spacin