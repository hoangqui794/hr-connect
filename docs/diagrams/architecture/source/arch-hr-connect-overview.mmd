---
title: HR Connect — System Architecture Overview
---
flowchart LR
  subgraph ACTORS["1. USERS & ROLES"]
    direction TB
    A_EXT["👤 Candidate & Guest<br/>(Job Search, Self-Apply, Consent)"]
    A_PART["🤝 Client & Affiliate<br/>(Job Request, Referral, Fee & Payout)"]
    A_INT["🛡️ Internal HR & Admin<br/>(Review, Screening, Finance & Audit)"]
  end

  subgraph CLIENT["2. PRESENTATION TIER (Frontend SPA)"]
    direction TB
    FE_SPA["💻 HRConnect Web App<br/>(React 19 + TypeScript + Vite)<br/>Ant Design 5 · Tailwind · Zustand"]
    FE_COMM["🔌 Client Communication<br/>Axios REST + SignalR WebSocket"]
    FE_SPA --> FE_COMM
  end

  subgraph BACKEND["3. APPLICATION & AI TIER (Core Services)"]
    direction TB
    BE_API["⚙️ HRConnect Backend API (.NET 8)<br/>Clean Architecture + MediatR CQRS<br/>Minimal APIs · SignalR Hub · EF Core 8"]
    BE_WK["⏱️ Background Workers (IHostedService)<br/>AI Dispatcher · Warranty & Expiry Jobs"]
    AI_SVC["🤖 AI Matching Service (Python FastAPI)<br/>PDF/OCR Parser · LLM Judge · Sentence-BERT"]
    BE_API --> BE_WK
    BE_WK -->|"Async POST /score"| AI_SVC
    AI_SVC -.->|"Webhook /internal/ai-results"| BE_API
  end

  subgraph DATA["4. DATA & EXTERNAL SERVICES TIER"]
    direction TB
    DB[("🗄️ PostgreSQL 16 Database")]
    R2["☁️ Cloudflare R2 Storage"]
    VNPAY["💳 VNPay Payment Gateway"]
    AUTH["✉️ Resend Email & Google OAuth 2.0"]
    LLM["🧠 External LLM Providers"]
  end

  A_EXT & A_PART & A_INT -->|"HTTPS"| FE_SPA
  FE_COMM -->|"REST API (JSON / JWT)"| BE_API
  BE_API -.->|"SignalR Real-time Push"| FE_COMM
  BE_API -->|"EF Core / Npgsql"| DB
  BE_API -->|"S3 API"| R2
  BE_API -->|"Redirect & IPN"| VNPAY
  BE_API -->|"HTTPS / OAuth"| AUTH
  AI_SVC -->|"LLM Prompt & OCR"| LLM
