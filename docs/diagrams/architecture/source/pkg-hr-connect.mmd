---
title: HR Connect – Package Diagram (UML 2.5)
config:
  layout: elk
---
flowchart LR
  subgraph FE["HRConnect-FE (React + TypeScript)"]
    direction TB
    FE0["app · routes"]
    FE1["pages · features"]
    FE2["components"]
    FE3["services · stores · hooks"]
  end
  subgraph PRES["HRConnect.Presentation (.NET 8 Web API)"]
    direction TB
    PRES0["Endpoints (V1, Internal)"]
    PRES1["Hubs (SignalR)"]
    PRES2["Authorization · Middleware"]
  end
  subgraph APP["HRConnect.Application (CQRS + MediatR)"]
    direction TB
    APP0["Features (Auth, MF-01..MF-05)"]
    APP1["Common (Interfaces, Policies, Models)"]
  end
  subgraph DOM["HRConnect.Domain (Core)"]
    direction TB
    DOM0["Entities (72)"]
    DOM1["Constants (States, Error Codes)"]
  end
  subgraph INF["HRConnect.Infrastructure (.NET 8)"]
    direction TB
    INF0["Persistence · Repositories"]
    INF1["Authentication (JWT)"]
    INF2["Services (R2, Resend, VNPay, AI Client)"]
  end
  subgraph AI["ai-service-v2 (Python FastAPI)"]
    direction TB
    AI0["api · pipeline"]
    AI1["documents · semantic · llm"]
  end
  FE -.->|"«use»"| PRES
  PRES -.->|"«use»"| APP
  PRES -.->|"«use»"| INF
  APP -.->|"«import»"| DOM
  INF -.->|"«use»"| APP
  INF -.->|"«import»"| DOM
  INF -.->|"«use»"| AI
  classDef default fill:#FFFFFF,stroke:#1B365D,color:#1F2A3C
  style FE fill:#F2F7FD,stroke:#1B365D
  style PRES fill:#F1F8F2,stroke:#2F6B3A
  style APP fill:#F1F8F2,stroke:#2F6B3A
  style DOM fill:#F1F8F2,stroke:#2F6B3A
  style INF fill:#F1F8F2,stroke:#2F6B3A
  style AI fill:#F7F2FD,stroke:#6B46C1
