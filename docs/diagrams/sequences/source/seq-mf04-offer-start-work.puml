@startuml seq-mf04-offer-start-work
title sd MF-04b: Offer Issuance, Candidate Acceptance & Start-Work Reconciliation
autonumber
hide footbox
actor "Client Company User" as CL
actor "Candidate" as CA
participant "Offer / StartWork / Reconcile Handlers" as H
participant "PlacementFinanceService" as F
participant "PostgreSQL" as DB
actor "Internal HR" as HR
actor "Platform Admin" as AD
CL -> H : Create & Send Offer (Salary, StartDate, ExpiryDate)
alt HEADHUNT_COD and Salary is not Gross Monthly
H --> CL : 400 Bad Request (HEADHUNT_REQUIRES_GROSS)
else Valid Offer Terms
H -> DB : Save Offer (SENT) & update Application -> OFFER_PENDING
H --> CA : Notify Candidate of new Job Offer
CA -> H : RespondToOffer(ACCEPT)
H -> DB : Update Offer -> ACCEPTED, Application -> OFFER_ACCEPTED
CL -> H : ConfirmStartWork(actualStartDate)
H -> H : Validate actualStartDate <= today and >= offer accepted date
H -> DB : Insert Placement (STARTED) & update Application -> PLACED
H -> F : InitializeAsync(placement)
F -> DB : Insert ServiceFee (PENDING), Warranty (ACTIVE) & Commission (IN_WARRANTY)
H -> DB : Insert PlacementReconciliation (PENDING, ClaimedOutcome: STARTED)
HR -> H : ReconcilePlacement(CONFIRM or FLAG, contactChannel, note)
alt Action == CONFIRM
H -> DB : Update Reconciliation -> CONFIRMED & ServiceFee -> DUE
H --> CL : 200 OK (Placement Confirmed & Fee Due)
else Action == FLAG
H -> DB : Update Reconciliation -> FLAGGED (ServiceFee remains PENDING)
H --> AD : Notify Platform Admin to resolve flagged reconciliation
end
end
@enduml
