@startuml seq-mf03-sourcing-delivery
title sd MF-03c: CV Sourcing Delivery, Client Review & Auto-Accept
autonumber
hide footbox
actor "Internal HR" as HR
participant "SourcingDeliveryEndpoints" as API
participant "SourcingDeliveryHandlers" as H
participant "PostgreSQL" as DB
actor "Client Company User" as CL
participant "SourcingAutoAcceptService" as W
HR -> API : POST /api/v1/jobs/{id}/sourcing-deliveries (ApplicationId)
API -> H : Send(DeliverSourcingCvCommand)
alt Sourcing Target Already Reached
H --> API : Throw ConflictException (SOURCING_TARGET_REACHED)
API --> HR : 409 Conflict
else Within Sourcing Target
H -> DB : Insert SourcingDelivery (DELIVERED, ReviewDueAt)
H --> CL : Notify Client: New sourced CV ready for review
API --> HR : 201 Created (SourcingDeliveryDto)
end
alt Client Reviews Before Deadline
CL -> API : POST /api/v1/sourcing-deliveries/{id}/decision (ACCEPT / REJECT)
API -> H : Send(DecideSourcingDeliveryCommand)
H -> DB : Update Delivery -> ACCEPTED (unlocks per-CV commission) or REJECTED
API --> CL : 200 OK
else Review Window Expires Without Client Response
W -> DB : Mark overdue DELIVERED -> AUTO_ACCEPTED & unlock Commission
end
@enduml
