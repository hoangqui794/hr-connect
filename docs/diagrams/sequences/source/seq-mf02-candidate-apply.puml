@startuml seq-mf02-candidate-apply
title sd MF-02a: Candidate Self-Application to Direct Job
autonumber
hide footbox
actor "Candidate" as CA
participant "Web App (HRConnect-FE)" as FE
participant "JobEndpoints" as API
participant "ApplyJobCommandHandler" as H
participant "Cloudflare R2 Storage" as R2
participant "PostgreSQL" as DB
participant "Mf03ScoringTrigger" as AI
CA -> FE : Open active CV_APPLICATION job & select/upload CV
FE -> API : POST /api/v1/jobs/{id}/apply (ApplyJobCommand)
API -> H : Send(ApplyJobCommand)
H -> DB : Verify Candidate & Job ACTIVE, deadline & package limit
alt Not eligible or application limit reached
H --> API : Throw Forbidden / ConflictException
API --> FE : 403 Forbidden / 409 Conflict
else Eligible to Apply
H -> R2 : Upload new CV PDF (or validate existing CandidateCv)
H -> DB : Check existing Submission/Application for (CandidateId, JobId)
alt Duplicate Application Detected
H -> R2 : Delete newly uploaded CV PDF (Compensating action)
H -> DB : Insert Submission (BLOCKED_DUPLICATE) & AuditLog
API --> FE : 409 Conflict (Already applied to this Job)
else Unique Application
H -> DB : Insert Submission (ACCEPTED) & Application (SUBMITTED)
H -> AI : TriggerScoringAsync(applicationId) -> AiMatchResult PENDING
H --> API : Return ApplicationCreatedDto
API --> FE : 201 Created (Application SUBMITTED)
end
end
@enduml
