><mxPoint x="1257" y="563" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_10" value="11. Claim OnlinePayment -&gt; PROCESSING" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="631" as="sourcePoint"/><mxPoint x="1032" y="631" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_11" value="12. Record Fee -&gt; PAID (Ref: VNPAY-TxnNo) &amp; OnlinePayment -&gt; SUCCEEDED" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="675" as="sourcePoint"/><mxPoint x="1032" y="675" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_12" value="13. Send real-time notification: VNPay payment received" style="html=1;verticalAlign=bottom;dashed=1;endArrow=open;endFill=0;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="719" as="sourcePoint"/><mxPoint x="1482" y="719" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_13" value="14. Return RspCode 00 (Confirm Success)" style="html=1;verticalAlign=bottom;dashed=1;endArrow=open;endFill=0;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="763" as="sourcePoint"/><mxPoint x="1257" y="763" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_14" value="15. Redirect browser to /client/billing/vnpay-return" style="html=1;verticalAlign=bottom;dashed=1;endArrow=open;endFill=0;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1257" y="821" as="sourcePoint"/><mxPoint x="3