@startuml seq-mf05-warranty-fee-commission
title sd MF-05c: Warranty Completion, Commission Approval & Affiliate Payout
autonumber
hide footbox
participant "WarrantyProgressWorker" as W
participant "WarrantyProgressService" as S
participant "PostgreSQL" as DB
actor "Platform Admin" as AD
participant "SettlementCommandHandlers" as H
actor "Affiliate" as AF
W -> S : Execute daily warranty & fee progress check
S -> DB : Mark reconciled ServiceFee PENDING -> DUE (or OVERDUE)
S -> DB : Mark expired Warranty -> PASSED & Commission IN_WARRANTY -> EARNED
AD -> H : Send(RecordServiceFeePaymentCommand) (if paid via bank transfer)
H -> DB : Update ServiceFee -> PAID (PaidAt, PaymentReference)
AD -> H : Send(ApproveCommissionCommand)
alt ServiceFee not PAID or Active Dispute exists
H --> AD : 409 Conflict (SERVICE_FEE_NOT_PAID / COMMISSION_UNDER_DISPUTE)
else Fee PAID & No Active Dispute
H -> DB : Update Commission -> PAYABLE (ApprovedAt, ApprovedBy)
H --> AF : Notify Affiliate: Commission approved for payout
AD -> H : Send(RecordPayoutCommand) (Method, TransactionReference, EvidenceUrl)
H -> DB : Insert Payout (COMPLETED) & update Commission -> PAID
H --> AF : Notify Affiliate: Commission payout completed
H --> AD : 200 OK (PayoutResponse)
end
@enduml
