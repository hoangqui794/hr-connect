lvetica;fillColor=none;strokeColor=#64748B;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="25" y="549" width="1565" height="10" as="geometry"/></mxCell><mxCell id="m_0" value="1. Enter Candidate info (email, phone) &amp; upload CV PDF" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="132" y="145" as="sourcePoint"/><mxPoint x="357" y="145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_1" value="2. POST /api/v1/jobs/{id}/candidate-submissions" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="357" y="189" as="sourcePoint"/><mxPoint x="582" y="189" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_2" value="3. Send(SubmitCandidateCommand)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="233" as="sourcePoint"/><mxPoint x="807" y="233" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_3" value="4. Upload validated Affiliate CV PDF" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="277" as="sourcePoint"/><mxPoint x="1032" y="277" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_4" value="5. Match or create Candidate by normalized email / phone" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="321" as="sourcePoint"/><mxPoint x="1257" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_5" value="6. Check duplicate Submission or pending Consent for this Job" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="365" as="sourcePoint"/><mxPoint x="1257" y="365" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_6" value="7. Insert Submission (BLOCKED_DUPLICATE), preserve first Attribution" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="431" as="sourcePoint"/><mxPoint x="1257" y="431" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_7" value="8. Throw ConflictException (BLOCKED_DUPLICATE)" style="html=1;verticalAlign=bottom;dashed=1;endArrow=open;endFill=0;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="475" as="sourcePoint"/><mxPoint x="582" y="475" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_8" value="9. 409 Conflict (Duplicate Referral)" style="html=1;verticalAlign=bottom;dashed=1;endArrow=open;endFill=0;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="519" as="sourcePoint"/><mxPoint x="357" y="519" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_9" value="10. Insert Submission (PENDING_CONSENT) &amp; SubmissionConsent (TokenHash)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="587" as="sourcePoint"/><mxPoint x="1257" y="587" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_10" value="11. Send Consent confirmation email with tokenized link" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="631" as="sourcePoint"/><mxPoint x="1482" y="631" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_11" value="12. Return SubmissionResultDto" style="html=1;verticalAlign=bottom;dashed=1;endArrow=open;endFill=0;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="807" y="675" as="sourcePoint"/><mxPoint x="582" y="675" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m_12" value="13. 201 Created (Awaiting Candidate Consent)" style="html=1;verticalAlign=bottom;dashed=1;endArrow=open;endFill=0;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="719" as="sourcePoint"/><mxPoint x="357" y="719" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>