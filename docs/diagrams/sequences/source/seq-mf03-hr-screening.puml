@startuml seq-mf03-hr-screening
autonumber
skinparam sequenceMessageAlign center
title MF-03 · Internal HR screens a Headhunt application
actor "Internal HR" as HR
boundary "Web App" as FE
boundary "Recruitment endpoints" as API
control "UpdateApplicationScreeningStatus handler" as H
database "PostgreSQL" as DB
actor "Client Company User" as CL
HR -> FE : Open application
FE -> API : POST /jobs/{jid}/applications/{aid}/start-screening
API -> DB : Application SUBMITTED → SCREENING
HR -> FE : Shortlist / Backup / Reject (+ reason code)
FE -> API : PATCH /api/v1/jobs/{jid}/applications/{aid}/status (ConcurrencyToken)
API -> H : Send command
alt reject without reason or stale token
API --> FE : 400 / 409
else valid
H -> DB : Status + ApplicationStatusHistory + AuditLog
H -> CL : New shortlisted candidate (contact masked)
end
@enduml
