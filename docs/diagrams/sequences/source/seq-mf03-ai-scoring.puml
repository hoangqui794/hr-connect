@startuml seq-mf03-ai-scoring
title sd MF-03a: Asynchronous Hybrid AI CV Matching and Scoring
autonumber
hide footbox
participant "Mf03ScoringDispatcher" as W
participant "AI Matching Service (FastAPI)" as AI
participant "External LLM Provider" as LLM
participant "AiIntegrationEndpoints" as API
participant "PostgreSQL" as DB
actor "Internal HR / Client" as HR
W -> DB : Claim PENDING AiMatchResult -> PROCESSING
W -> AI : POST /score (ApplicationId, JobId, CV URL)
AI -> AI : Extract CV text (OCR if scanned) & compute Sentence-BERT similarity
AI -> LLM : Evaluate MUST_HAVE / SHOULD_HAVE requirements with verbatim quotes
LLM --> AI : Return structured JSON requirement assessment
AI -> AI : Verify quotes in CV text & compute weighted score (cap 59 if missing MUST)
AI -> API : POST /api/v1/internal/ai-results (Score, Tier, Evidence)
alt Scoring Succeeded
API -> DB : Update AiMatchResult -> COMPLETED (MatchScore, MatchTier)
API --> HR : Push SignalR event: application.scored
API --> AI : 200 OK
else LLM Error or Max Retries Exhausted
API -> DB : Update AiMatchResult -> FAILED (FailureCode)
API --> HR : Notify screener (Manual AI Retry available)
API --> AI : 200 OK
end
@enduml
