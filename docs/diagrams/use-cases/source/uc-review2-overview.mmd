    subgraph PUB["Public & Authentication"]
      direction LR
      UC_REG(["Register Account"]):::uc
      UC_VER(["Verify Email / Recover Password"]):::uc
      UC_LOG(["Login"]):::uc
      UC_SRCH(["Search & View Jobs"]):::uc
    end

    subgraph CAN["Candidate & CV Management"]
      direction LR
      UC_CPROF(["Manage Candidate Profile"]):::uc
      UC_MCV(["Manage CV"]):::uc
      UC_BCV(["Build CV and View AI Job Suggestions"]):::uc
      UC_CLAIM(["Claim Candidate Profile & Manage Identity"]):::uc
    end

    subgraph SUB["Submission & Consent"]
      direction LR
      UC_APPLY(["Apply to Job"]):::uc
      UC_SUB(["Submit Candidate / CV"]):::uc
      UC_CONS(["Respond to Submission Consent"]):::uc
      UC_WDR(["Withdraw Application"]):::uc
    end

    subgraph AFF["Affiliate & Disputes"]
      direction LR
      UC_APROF(["Manage Affiliate Profile"]):::uc
      UC_ATRK(["Track Own Submission"]):::uc
      UC_APERF(["View Affiliate Performance"]):::uc
      UC_ACOM(["View Commission & Payout"]):::uc
      UC_RDISP(["Raise Attribution Dispute"]):::uc
      UC_AREV(["Review Affiliate Application"]):::uc
    end

    subgraph JOB["Company & Job Management"]
      direction LR
      UC_COM(["Manage Company Profile"]):::uc
      UC_CREV(["Review Company Verification"]):::uc
      UC_MJOB(["Manage Job"]):::uc
      UC_RJOB(["Review Job"]):::uc
      UC_SA(["Agree and Sign Service Agreement"]):::uc
      UC_JDT(["Manage JD Templates"]):::uc
    end

    subgraph SCR["AI Matching & Screening"]
      direction LR
      UC_AI(["View AI Matching Result"]):::uc
      UC_SCR(["Screen Candidate"]):::uc
      UC_RCAN(["Review Candidate"]):::uc
      UC_SRC(["Deliver & Review CVs (CV Sourcing)"]):::uc
    end

    subgraph HIR["Interview, Offer & Warranty"]
      direction LR
      UC_MINT(["Manage Interview"]):::uc
      UC_PINT(["Participate in Interview"]):::uc
      UC_VINT(["View Interview Schedule"]):::uc
      UC_RINT(["Record Interview Result"]):::uc
      UC_MOFF(["Manage Offer"]):::uc
      UC_ROFF(["Respond to Offer"]):::uc
      UC_STRT(["Confirm Start Work / Placement"]):::uc
      UC_RECON(["Reconcile Placement"]):::uc
      UC_WAR(["Manage Warranty & Replacement Slot"]):::uc
    end

    subgraph FIN["Finance, Administration & Reporting"]
      direction LR
      UC_PAY(["Pay, Settle & Record Service Fee / Deposit"]):::uc
      UC_MCOM(["Manage Commission & Payout"]):::uc
      UC_DISP(["Resolve Duplicate Case & Attribution Dispute"]):::uc
      UC_USR(["Manage Users"]):::uc
      UC_ROLE(["Manage Roles & Permissions"]):::uc
      UC_CFG(["Manage System Configuration"]):::uc
      UC_AUD(["View Audit Log"]):::uc
      UC_CONT(["Handle Contact Requests"]):::uc
      UC_RPT(["View Reports & Dashboard"]):::uc
    end
  end

