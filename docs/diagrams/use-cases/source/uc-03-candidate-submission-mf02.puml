@startuml uc-03-candidate-submission-mf02
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase { BackgroundColor #EAF2FB
  BorderColor #1B365D }
title Use Cases – Candidate, CV & Submission (MF-02)

actor "Candidate" as C
actor "Affiliate" as A
actor "Platform Admin" as AD
rectangle "HR Connect" {
  usecase "UC-08\nManage Candidate Profile" as UC08
  usecase "UC-09\nManage CV" as UC09
  usecase "UC-46\nBuild CV and View Job Suggestions" as UC46
  usecase "UC-10\nApply to Job" as UC10
  usecase "UC-11\nSubmit Candidate/CV" as UC11
  usecase "UC-38\nRespond to Submission Consent" as UC38
  usecase "UC-40\nWithdraw Application" as UC40
  usecase "UC-13\nRaise Duplicate / Attribution Dispute" as UC13
  usecase "UC-14\nResolve Duplicate / Attribution Dispute" as UC14
}
C -- UC08
C -- UC09
C -- UC46
C -- UC10
C -- UC38
C -- UC40
A -- UC11
A -- UC13
UC14 -- AD
@enduml
