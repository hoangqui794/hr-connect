@startuml uc-04-ai-screening-mf03
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase { BackgroundColor #EAF2FB
  BorderColor #1B365D }
title Use Cases – AI Matching & Screening (MF-03)

actor "Client Company User" as CL
actor "Internal HR" as HR
rectangle "HR Connect" {
  usecase "UC-15\nView AI Matching Result" as UC15
  usecase "UC-16\nScreen Candidate" as UC16
  usecase "UC-17\nReview Candidate" as UC17
  usecase "UC-45\nReview Delivered CVs (CV Sourcing)" as UC45
}
CL -- UC15
CL -- UC16
CL -- UC17
CL -- UC45
UC15 -- HR
UC16 -- HR
@enduml
