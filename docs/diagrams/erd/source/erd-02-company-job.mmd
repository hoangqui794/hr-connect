    bool IsFeatured
    varchar TaxCode
    timestamptz UpdatedAt
    varchar VerificationStatus
    timestamptz VerifiedAt
    varchar Website
  }
  CompanyUser {
    uuid CompanyUserId PK
    uuid CompanyId FK
    timestamptz CreatedAt
    bool IsPrimaryContact
    varchar RoleInCompany
    varchar Status
    timestamptz UpdatedAt
    uuid UserId FK
  }
  CompanyVerificationRequest {
    uuid CompanyVerificationRequestId PK
    uuid CompanyId FK
    text ReviewNote
    timestamptz ReviewedAt
    uuid ReviewedBy FK
    varchar Status
    timestamptz SubmittedAt
    uuid SubmittedBy FK
    jsonb SubmittedPayload
  }
  Industry {
    uuid IndustryId PK
    varchar Code
    timestamptz CreatedAt
    bool IsActive
    smallint Level
    varchar NameEn
    varchar NameVi
