AppUser ||--o{ Interview : CreatedBy
Application ||--o{ Offer : ApplicationId
AppUser ||--o{ Offer : CreatedBy
Application ||--o{ Placement : ApplicationId
Offer ||--o{ Placement : OfferId
ReplacementSlot ||--o{ Placement : ReplacementSlotId
Application ||--o{ PlacementReconciliation : ApplicationId
Placement ||--o{ PlacementReconciliation : PlacementId
Job ||--o{ SourcingDelivery : JobId
Application ||--o{ SourcingDelivery : ApplicationId
Placement ||--o{ Warranty : PlacementId
Placement ||--o{ ServiceFee : PlacementId
Job ||--o{ ServiceFee : JobId
Company ||--o{ ServiceFee : CompanyId
Job ||--o{ ReplacementSlot : JobId
Placement ||--o{ ReplacementSlot : OriginalPlacementId
ServiceFee ||--o{ ReplacementSlot : ServiceFeeId
Placement ||--o{ ReplacementSlot : FilledByPlacementId
AppUser ||--o{ ReplacementSlot : CreatedBy
ServiceType ||--o{ CommissionRule : ServiceTypeId
Attribution ||--o{ Commission : AttributionId
Placement ||--o{ Commission : PlacementId
CommissionRule ||--o{ Commission : CommissionRuleId
Commission ||--o{ Payout : CommissionId
