---
title: Core ERD 05 - Fee, warranty, commission and payout
config:
  layout: elk
---
erDiagram
  ServiceType {
    uuid ServiceTypeId PK
    varchar Code
  }
  Attribution {
    uuid AttributionId PK
    uuid ApplicationId FK
    uuid AffiliateId FK
  }
  SourcingDelivery {
    uuid DeliveryId PK
    uuid JobId FK
    varchar Status
  }
  Application {
    uuid ApplicationId PK
    uuid JobId FK
    varchar Status
  }
  Offer {
    uuid OfferId PK
    uuid ApplicationId FK
  }
  Job {
    uuid JobId PK
    uuid CompanyId FK
    numeric FeeMultiplier
    int WarrantyDays
  }
  Company {
    uuid CompanyId PK
    varchar Name
  }
  CommissionRule {
    uuid CommissionRuleId PK
    uuid ServiceTypeId FK
    varchar MilestoneType
    varchar RateType
    numeric RateValue
    boolean WarrantyRequired
    boolean IsActive
  }
  Commission {
    uuid CommissionId PK
    uuid AttributionId FK
    uuid PlacementId FK
    uuid SourcingDeliveryId FK
    uuid CommissionRuleId FK
    varchar MilestoneType
    numeric Amount
    varchar Status
    timestamptz ApprovedAt
  }
  Placement {
    uuid PlacementId PK
    uuid ApplicationId FK
    uuid OfferId FK
    uuid ReplacementSlotId FK
    date ActualStartDate
    varchar Status
    timestamptz ConfirmedAt
  }
  ServiceFee {
    uuid ServiceFeeId PK
    uuid PlacementId FK
    uuid JobId FK
    uuid CompanyId FK
    varchar Kind
    numeric BaseSalary
    numeric FeeMultiplier
    numeric Amount
    date DueDate
    varchar Status
    varchar PaymentReference
  }
  Payout {
    uuid PayoutId PK
    uuid CommissionId FK
    uuid RecordedBy FK
    numeric Amount
    int AttemptNo
    varchar TransactionReference
    varchar Status
  }
  CommissionAdjustment {
    uuid CommissionAdjustmentId PK
    uuid CommissionId FK
    uuid AdjustedBy FK
    numeric OldAmount
    numeric NewAmount
    varchar Reason
  }
  Dispute {
    uuid DisputeId PK
    uuid SubmissionId FK
    uuid AttributionId FK
    uuid CommissionId FK
    uuid RaisedBy FK
    varchar DisputeType
    varchar Status
    varchar Resolution
  }
  PlacementReconciliation {
    uuid ReconciliationId PK
    uuid ApplicationId FK
    uuid PlacementId FK
    uuid ReviewedBy FK
    varchar ClaimedOutcome
    varchar Status
    varchar ResolutionAction
    timestamptz ReviewedAt
  }
  Warranty {
    uuid WarrantyId PK
    uuid PlacementId FK
    date StartDate
    date EndDate
    varchar Status
  }
  ReplacementSlot {
    uuid ReplacementSlotId PK
    uuid JobId FK
    uuid OriginalPlacementId FK
    uuid ServiceFeeId FK
    uuid FilledByPlacementId FK
    varchar Status
    int FillWindowDays
    timestamptz ExpiresAt
  }
  ServiceType ||--o{ CommissionRule : "ServiceTypeId"
  CommissionRule ||--o{ Commission : "CommissionRuleId"
  Attribution ||--o{ Commission : "AttributionId"
