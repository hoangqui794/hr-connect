@startuml erd-core-05-finance
title Core ERD 05 - Fee, warranty, commission and payout
hide circle
skinparam linetype ortho
entity ServiceType #EEEEEE {
  * ServiceTypeId : uuid <<PK>>
  --
  Code : varchar
}
entity Attribution #EEEEEE {
  * AttributionId : uuid <<PK>>
  --
  ApplicationId : uuid <<FK>>
  AffiliateId : uuid <<FK>>
}
entity SourcingDelivery #EEEEEE {
  * DeliveryId : uuid <<PK>>
  --
  JobId : uuid <<FK>>
  Status : varchar
}
entity Application #EEEEEE {
  * ApplicationId : uuid <<PK>>
  --
  JobId : uuid <<FK>>
  Status : varchar
}
entity Offer #EEEEEE {
  * OfferId : uuid <<PK>>
  --
  ApplicationId : uuid <<FK>>
}
entity Job #EEEEEE {
  * JobId : uuid <<PK>>
  --
  CompanyId : uuid <<FK>>
  FeeMultiplier : numeric
  WarrantyDays : int
}
entity Company #EEEEEE {
  * CompanyId : uuid <<PK>>
  --
  Name : varchar
}
entity CommissionRule #DAE8FC {
  * CommissionRuleId : uuid <<PK>>
  --
  ServiceTypeId : uuid <<FK>>
  MilestoneType : varchar
  RateType : varchar
  RateValue : numeric
  WarrantyRequired : boolean
  IsActive : boolean
}
entity Commission #DAE8FC {
  * CommissionId : uuid <<PK>>
  --
  AttributionId : uuid <<FK>>
  PlacementId : uuid <<FK>>
  SourcingDeliveryId : uuid <<FK>>
  CommissionRuleId : uuid <<FK>>
  MilestoneType : varchar
  Amount : numeric
  Status : varchar
  ApprovedAt : timestamptz
}
entity Placement #DAE8FC {
  * PlacementId : uuid <<PK>>
  --
  ApplicationId : uuid <<FK>>
  OfferId : uuid <<FK>>
  ReplacementSlotId : uuid <<FK>>
  ActualStartDate : date
  Status : varchar
  ConfirmedAt : timestamptz
}
entity ServiceFee #DAE8FC {
  * ServiceFeeId : uuid <<PK>>
  --
  PlacementId : uuid <<FK>>
  JobId : uuid <<FK>>
  CompanyId : uuid <<FK>>
  Kind : varchar
  BaseSalary : numeric
  FeeMultiplier : numeric
  Amount : numeric
  DueDate : date
  Status : varchar
  PaymentReference : varchar
}
entity Payout #DAE8FC {
  * PayoutId : uuid <<PK>>
  --
  CommissionId : uuid <<FK>>
  RecordedBy : uuid <<FK>>
  Amount : numeric
  AttemptNo : int
  TransactionReference : varchar
  Status : varchar
}
entity CommissionAdjustment #DAE8FC {
  * CommissionAdjustmentId : uuid <<PK>>
  --
  CommissionId : uuid <<FK>>
  AdjustedBy : uuid <<FK>>
  OldAmount : numeric
  NewAmount : numeric
  Reason : varchar
}
entity Dispute #DAE8FC {
  * DisputeId : uuid <<PK>>
  --
  SubmissionId : uuid <<FK>>
  AttributionId : uuid <<FK>>
  CommissionId : uuid <<FK>>
  RaisedBy : uuid <<FK>>
  DisputeType : varchar
  Status : varchar
  Resolution : varchar
}
entity PlacementReconciliation #DAE8FC {
  * ReconciliationId : uuid <<PK>>
  --
  ApplicationId : uuid <<FK>>
  PlacementId : uuid <<FK>>
  ReviewedBy : uuid <<FK>>
  ClaimedOutcome : varchar
  Status : varchar
  ResolutionAction : varchar
  ReviewedAt : timestamptz
}
entity Warranty #DAE8FC {
  * WarrantyId : uuid <<PK>>
  --
  PlacementId : uuid <<FK>>
  StartDate : date
  EndDate : date
  Status : varchar
}
entity ReplacementSlot #DAE8FC {
  * ReplacementSlotId : uuid <<PK>>
  --
  JobId : uuid <<FK>>
  OriginalPlacementId : uuid <<FK>>
  ServiceFeeId : uuid <<FK>>
  FilledByPlacementId : uuid <<FK>>
  Status : varchar
  FillWindowDays : int
  ExpiresAt : timestamptz
}
ServiceType ||--o{ CommissionRule : ServiceTypeId
CommissionRule ||--o{ Commission : CommissionRuleId
Attribution ||--o{ Commission : AttributionId
SourcingDelivery ||--o{ Commission : SourcingDeliveryId
Placement ||--o{ Commission : PlacementId
Application ||--o{ Placement : ApplicationId
Offer ||--o{ Placement : OfferId
ReplacementSlot ||--o{ Placement : ReplacementSlotId
Placement ||--o{ ServiceFee : PlacementId
Job ||--o{ ServiceFee : JobId
Company ||--o{ ServiceFee : CompanyId
Commission ||--o{ Payout : CommissionId
Commission ||--o{ CommissionAdjustment : CommissionId
Commission ||--o{ Dispute : CommissionId
Attribution ||--o{ Dispute : AttributionId
Application ||--o{ PlacementReconciliation : ApplicationId
Placement ||--o{ PlacementReconciliation : PlacementId
Placement ||--o{ Warranty : PlacementId
Job ||--o{ ReplacementSlot : JobId
Placement ||--o{ ReplacementSlot : OriginalPlacementId
Placement ||--o{ ReplacementSlot : FilledByPlacementId
ServiceFee ||--o{ ReplacementSlot : ServiceFeeId
@enduml
