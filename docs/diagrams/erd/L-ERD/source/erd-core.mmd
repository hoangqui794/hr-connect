---
title: HR Connect – Core Logical ERD (40 Entities)
config:
  layout: elk
---
erDiagram
  AppUser {
    key UserId PK
    attr Email
    attr DisplayName
    attr Phone
    attr Status
  }
  Role {
    key RoleId PK
    attr Code
    attr Name
    attr IsSystem
  }
  UserRole {
    key UserId PK,FK
    key RoleId PK,FK
    attr AssignmentSource
    attr Status
  }
  Company {
    key CompanyId PK
    attr CompanyName
    attr TaxCode
    attr VerificationStatus
  }
  CompanyUser {
    key CompanyUserId PK
    key CompanyId FK
    key UserId FK
    attr RoleInCompany
    attr IsPrimaryContact
  }
  AffiliateProfile {
    key AffiliateId PK
    key UserId FK
    attr BankName
    attr BankAccountNumber
    attr Status
  }
  Candidate {
    key CandidateId PK
    key UserId FK
    key MergedIntoCandidateId FK
    attr FullName
    attr NormalizedEmail
    attr NormalizedPhone
    attr Status
  }
  CandidateCv {
    key CvId PK
    key CandidateId FK
    key UploadedByUserId FK
    attr FileName
    attr SourceType
    attr AllowAffiliateReuse
    attr Status
  }
  CandidateIdentityClaim {
    key ClaimId PK
    key RequesterUserId FK
    key TargetCandidateId FK
    key ReviewedBy FK
    attr EvidenceUrl
    attr Status
  }
  CandidateDuplicateCase {
    key DuplicateCaseId PK
    key CandidateAId FK
    key CandidateBId FK
    key CanonicalCandidateId FK
    key SubmissionId FK
    attr ConfidenceScore
    attr Status
  }
  UserEmailIdentity {
    key EmailIdentityId PK
    key UserId FK
    attr NormalizedEmail
    attr Kind
    attr Status
  }
  CandidateJobMatch {
    key CandidateJobMatchId PK
    key CandidateId FK
    key JobId FK
    key CvId FK
    attr MatchScore
    attr MatchTier
    attr Status
  }
  JobTemplate {
    key TemplateId PK
    attr Code
    attr Name
    attr Industry
    attr IsActive
  }
  JobTemplateRequirement {
    key TemplateRequirementId PK
    key TemplateId FK
    attr RequirementType
    attr Content
  }
  ContactRequest {
    key ContactRequestId PK
    key HandledBy FK
    attr FullName
    attr Email
    attr ServiceInterest
    attr Status
  }
  ServiceType {
    key ServiceTypeId PK
    attr Code
    attr Name
  }
  Job {
    key JobId PK
    key CompanyId FK
    key ServiceTypeId FK
    key CreatedBy FK
    key CurrentServiceAgreementId FK
    attr Title
    attr Quantity
    attr FeeMultiplier
    attr WarrantyDays
    attr SourcingTarget
    attr Status
  }
  JobRequirement {
    key RequirementId PK
    key JobId FK
    attr RequirementType
    attr CriteriaText
    attr Weight
  }
  ServiceAgreement {
    key ServiceAgreementId PK
    key JobId FK
    key CompanyId FK
    key CreatedByUserId FK
    key SignerUserId FK
    attr Version
    attr VerificationCode
    attr SignedPdfObjectKey
    attr Status
  }
  JobPostingPackage {
    key PackageId PK
    attr Code
    attr Name
    attr Price
    attr MaxApplications
  }
  JobPostingFee {
    key PostingFeeId PK
    key JobId FK
    key PackageId FK
    key CompanyId FK
    attr Amount
    attr PaymentReference
    attr Status
  }
  Submission {
    key SubmissionId PK
    key CandidateId FK
    key CvId FK
    key JobId FK
    key SubmittedBy FK
    key ReplacementSlotId FK
    attr Source
    attr Status
  }
  SubmissionConsent {
    key ConsentId PK
    key SubmissionId FK
    attr ConsentTokenHash
    attr RespondedAt
    attr ExpiresAt
    attr Status
  }
  Application {
    key ApplicationId PK
    key JobId FK
    key CandidateId FK
    key AcceptedSubmissionId FK
    key ReplacementSlotId FK
    attr CurrentStage
    attr Status
  }
  ApplicationStatusHistory {
    key ApplicationStatusHistoryId PK
    key ApplicationId FK
    key ChangedBy FK
    attr OldStatus
    attr NewStatus
    attr ReasonCode
  }
  Attribution {
    key AttributionId PK
    key ApplicationId FK
    key AffiliateId FK
    key WinningSubmissionId FK
    attr RuleApplied
    attr Status
  }
  AiMatchResult {
    key MatchResultId PK
    key ApplicationId FK
    attr MatchScore
    attr MatchTier
    attr KnockedOut
    attr Status
  }
  SourcingDelivery {
    key DeliveryId PK
    key JobId FK
    key ApplicationId FK
    attr ReviewDueAt
    attr Status
  }
  Interview {
    key InterviewId PK
    key ApplicationId FK
    key CreatedBy FK
    attr RoundNumber
    attr ScheduledAt
    attr CandidateConfirmed
    attr Result
    attr Status
  }
  Offer {
    key OfferId PK
    key ApplicationId FK
    key CreatedBy FK
    attr BaseSalary
    attr ProposedStartDate
    attr Status
  }
  Placement {
    key PlacementId PK
    key ApplicationId FK
    key OfferId FK
    key ReplacementSlotId FK
    key ConfirmedBy FK
    attr ActualStartDate
    attr Status
  }
  PlacementReconciliation {
    key ReconciliationId PK
    key ApplicationId FK
    key PlacementId FK
    key ReviewedBy FK
    attr ClaimedOutcome
    attr ResolutionAction
    attr Status
  }
  Warranty {
    key WarrantyId PK
    key PlacementId FK
    attr StartDate
    attr EndDate
    attr ResignationReason
    attr Status
  }
  ServiceFee {
    key ServiceFeeId PK
    key PlacementId FK
    key JobId FK
    key CompanyId FK
    attr Kind
    attr Amount
    attr DueDate
    attr PaymentReference
    attr Status
  }
  OnlinePayment {
    key OnlinePaymentId PK
    key CompanyId FK
    key CreatedBy FK
    attr Provider
    attr TargetType
    attr TargetId
    attr TxnRef
    attr Amount
    attr ProviderTransactionNo
    attr Status
  }
  ReplacementSlot {
    key ReplacementSlotId PK
    key JobId FK
    key OriginalPlacementId FK
    key ServiceFeeId FK
    key FilledByPlacementId FK
    attr ExpiresAt
    attr Status
  }
  CommissionRule {
    key CommissionRuleId PK
    key ServiceTypeId FK
    attr MilestoneType
    attr RateType
    attr RateValue
    attr WarrantyRequired
  }
  Commission {
    key CommissionId PK
    key AttributionId FK
    key PlacementId FK
    key SourcingDeliveryId FK
    key CommissionRuleId FK
    attr MilestoneType
    attr Amount
    attr Status
  }
  Payout {
    key PayoutId PK
    key CommissionId FK
    key RecordedBy FK
    attr Amount
    attr TransactionReference
    attr Status
  }
  Dispute {
    key DisputeId PK
    key SubmissionId FK
    key AttributionId FK
    key CommissionId FK
    key CandidateDuplicateCaseId FK
    key RaisedBy FK
    attr DisputeType
    attr Resolution
    attr Status
  }

