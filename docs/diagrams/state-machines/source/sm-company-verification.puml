@startuml sm-company-verification
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
  FontColor #0F172A
}
title State Machine — Company Verification (SF-01)
left to right direction
[*] --> PENDING : Company registered
PENDING --> UNDER_REVIEW : Verification docs submitted
UNDER_REVIEW --> VERIFIED : Platform Admin approves
UNDER_REVIEW --> REJECTED : Platform Admin rejects (note)
REJECTED --> UNDER_REVIEW : Client updates & resubmits
VERIFIED --> [*]
@enduml
