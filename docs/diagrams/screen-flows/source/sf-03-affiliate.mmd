  affiliate_subs -->|"open"| affiliate_subd
  affiliate_subd -->|"blocked duplicate → dispute"| affiliate_disp
  affiliate_dash --> affiliate_attr
  affiliate_dash --> affiliate_comm
  affiliate_dash --> affiliate_perf
  affiliate_dash --> affiliate_prof
  classDef default fill:#F3E8FF,stroke:#1B365D,color:#1F2A3C
