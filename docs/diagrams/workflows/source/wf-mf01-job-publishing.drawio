<mxfile host="app.diagrams.net"><diagram id="wf-mf01-job-publishing" name="wf-mf01-job-publishing"><mxGraphModel dx="1250" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="560" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MF-01: Job Creation, Review &amp; Service Activation" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1250" height="30" as="geometry"/></mxCell><mxCell id="l_client" value="Client Company User" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#FAF5FF;strokeColor=#9333EA;swimlaneFillColor=#FAF5FF;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#581C87;rounded=1;arcSize=4;collapsible=0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="470" height="485" as="geometry"/></mxCell><mxCell id="l_sys" value="HR Connect System" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#F0FDFA;strokeColor=#0D9488;swimlaneFillColor=#F0FDFA;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#134E4A;rounded=1;arcSize=4;collapsible=0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="510" y="55" width="280" height="485" as="geometry"/></mxCell><mxCell id="l_hr" value="Internal HR" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#EA580C;swimlaneFillColor=#FFF7ED;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#7C2D12;rounded=1;arcSize=4;collapsible=0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="810" y="55" width="420" height="310" as="geometry"/></mxCell><mxCell id="l_admin" value="Platform Admin" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#2563EB;swimlaneFillColor=#EFF6FF;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#1E3A8A;rounded=1;arcSize=4;collapsible=0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="810" y="385" width="420" height="155" as="geometry"/></mxCell><mxCell id="n1" value="1. Select Service Type&lt;br/&gt;(AP / SOURCING / HEADHUNT)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="58" as="geometry"/></mxCell><mxCell id="n2" value="2. Enter Job Details, JD Template&lt;br/&gt;&amp; MUST / SHOULD Requirements" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="265" y="110" width="205" height="58" as="geometry"/></mxCell><mxCell id="n3" value="3. Select Package / Propose Terms&lt;br/&gt;&amp; Submit Job for Review" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="265" y="205" width="205" height="58" as="geometry"/></mxCell><mxCell id="n_edit" value="Edit &amp; Resubmit&lt;br/&gt;Rejected Job" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="180" height="58" as="geometry"/></mxCell><mxCell id="n_sys1" value="Validate Data &amp; Set&lt;br/&gt;PENDING_REVIEW" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="550" y="205" width="200" height="58" as="geometry"/></mxCell><mxCell id="n_hr1" value