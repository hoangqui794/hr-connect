flowchart LR
  subgraph Actors["Human Actors"]
    G["<b>Guest</b>"]
    C["<b>Candidate</b>"]
    AF["<b>Affiliate Collaborator</b>"]
    CL["<b>Client Company User</b>"]
    HR["<b>Internal HR</b>"]
    AD["<b>Platform Admin</b>"]
  end

  SYS(("<b>0<br/>HR-Connect System</b><br/>Web App + Backend API<br/>+ AI Matching Service"))

  subgraph External_Systems["External Systems"]
    GGL[("<b>Google OAuth 2.0</b>")]
    MAIL[("<b>Email Service</b><br/>(SMTP / Resend)")]
    R2[("<b>Object Storage</b><br/>(Cloudflare R2)")]
    LLM[("<b>LLM Providers</b><br/>(Gemini / OpenAI / Anthropic)")]
    PAY[("<b>Payment Gateway</b><br/>(VNPay)")]
  end

  G -->|Public job search, registration, contact request, identity claim, agreement verify| SYS
  SYS -->|Public job catalog, verification result, claim & onboarding guidance| G

  C -->|Profile, CV/skills, saved jobs, applications, interview confirmation, offer response, CV visibility| SYS
  SYS -->|Job recommendations, application status, interview schedules, offers, notifications| C

  AF -->|Candidate referrals, CV submission, consent resend, disputes, bank account| SYS
  SYS -->|Partner jobs, referral status, duplicate warnings, commissions & payouts| AF

  CL -->|Company profile, job requests, agreement response & signed PDF upload, interview/offer decisions, payments| SYS
  SYS -->|Draft & signed agreements, curated shortlist, AI scores, warranty & payment receipts| CL

  HR -->|Job review, agreement drafting & signed PDF approval, CV curation, interviews, offers, placement & warranty| SYS
  SYS -->|Review & screening queues, AI matching results, SLA/warranty alerts, billing & commission tasks| HR

  AD -->|Company & Affiliate approvals, user/role governance, packages, identity claim & duplicate merge, dispute decisions| SYS
  SYS -->|Approval & claim queues, finance records, disputes, system metrics & audit trail| AD

  SYS -->|OAuth token verification request| GGL
  GGL -->|Verified user identity claims| SYS

  SYS -->|Verification OTP, password reset, consent requests, interview/offer/agreement emails| MAIL
  MAIL -->|Delivery status| SYS

  SYS -->|Upload/retrieve CV PDFs, signed agreements, claim evidence, avatars & logos| R2
  R2 -->|Stored files & presigned URLs| SYS

  SYS -->|CV content, structured parsing & job-candidate semantic scoring prompts| LLM
  LLM -->|Parsed candidate profile JSON & requirement assessments with evidence| SYS

  SYS -->|Signed payment URL & checkout request| PAY
  PAY -->|Signed IPN / return callback & payment result| SYS
