<mxfile host="app.diagrams.net"><diagram id="MF-05 activity" name="MF-05 activity"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1390" pageHeight="1860"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="act MF-05: Warranty, Commission and Payout (Headhunt COD)" style="text;html=1;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="26" as="geometry"/></mxCell><mxCell id="lane0" value="Client Company User" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="270" height="1780" as="geometry"/></mxCell><mxCell id="lane1" value="Internal HR" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="34" width="270" height="1780" as="geometry"/></mxCell><mxCell id="lane2" value="HR Connect System" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="34" width="320" height="1780" as="geometry"/></mxCell><mxCell id="lane3" value="Platform Admin" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="860" y="34" width="280" height="1780" as="geometry"/></mxCell><mxCell id="lane4" value="Affiliate" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="34" width="230" height="1780" as="geometry"/></mxCell><mxCell id="st" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="691" y="80" width="18" height="18" as="geometry"/></mxCell><mxCell id="s1" value="Client confirms the start of work (MF-04): Placement created" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="115" width="280" height="46" as="geometry"/></mxCell><mxCell id="s2" value="Create service fee PENDING (fee multiplier x gross monthly salary, due date from payment due days), Warranty ACTIVE, Commission IN_WARRANTY for the attributed Affiliate" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="190" width="290" height="74" as="geometry"/></mxCell><mxCell id="s3" value="Worker: fee DUE near the due date (Client reminded), OVERDUE after it" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="555" width="280" height="46" as="geometry"/></mxCell><mxCell id="c1" value="Pay the service fee before the due date" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="555" width="200" height="34" as="geometry"/></mxCell><mxCell id="ad1" value="Check the bank statement and record the fee payment with reference (fee PAID)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="680" width="230" height="46" as="geometry"/></mxCell><mxCell id="d1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="109" y="765" width="52" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Report that the Candidate left during the Warranty (last working date, reason)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="25" y="845" width="220" height="46" as="geometry"/></mxCell><mxCell id="s4" value="Warranty CLAIMED, Commission ON_HOLD, notify Internal HR" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillC