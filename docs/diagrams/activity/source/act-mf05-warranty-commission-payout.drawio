<mxfile host="app.diagrams.net"><diagram id="MF-05 activity" name="MF-05 activity"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1390" pageHeight="1480"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="act MF-05: Warranty, Commission and Payout (Headhunt COD)" style="text;html=1;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="26" as="geometry"/></mxCell><mxCell id="lane0" value="Client Company User" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="270" height="1400" as="geometry"/></mxCell><mxCell id="lane1" value="Internal HR" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="34" width="270" height="1400" as="geometry"/></mxCell><mxCell id="lane2" value="HR Connect System" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="34" width="320" height="1400" as="geometry"/></mxCell><mxCell id="lane3" value="Platform Admin" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="860" y="34" width="280" height="1400" as="geometry"/></mxCell><mxCell id="lane4" value="Affiliate" style="swimlane;startSize=30;html=1;fillColor=#E6EDF7;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="34" width="230" height="1400" as="geometry"/></mxCell><mxCell id="st" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="691" y="80" width="18" height="18" as="geometry"/></mxCell><mxCell id="s1" value="Placement STARTED and start-work reconciliation CONFIRMED (MF-04)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;font