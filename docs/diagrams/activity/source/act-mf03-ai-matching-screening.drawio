ob IDs to the AI service; AI result PROCESSING" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="185" width="230" height="46" as="geometry"/></mxCell><mxCell id="dA" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="124" y="258" width="52" height="40" as="geometry"/></mxCell><mxCell id="a1" value="Fetch JD and CV through the internal API and read the CV text (scans are read by the LLM)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="248" width="230" height="60" as="geometry"/></mxCell><mxCell id="a2" value="LLM judges each MUST_HAVE / SHOULD_HAVE requirement with verbatim quotes from the CV" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="330" width="230" height="60" as="geometry"/></mxCell><mxCell id="d1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="424" y="412" width="52" height="40" as="geometry"/></mxCell><mxCell id="s4" value="Mark AI result FAILED with failure code; show the error to the screener" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="409" width="230" height="46" as="geometry"/></mxCell><mxCell id="h0" value="Retry AI scoring (new attempt)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDF5D6;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="635" y="409" width="230" height="46" as="geometry"/></mxCell><mxCell id="a3" value="Code checks every quote and the experience years; unverified evidence becomes NOT_FOUND and is flagged for HR" style="rounded=1;