# ==============================================================================
# HRConnect Environment Configuration Template
# Sao chep file nay thanh `.env` va dien thong tin cau hinh thuc te cua ban
# KHONG commit file `.env` len GitHub!
# ==============================================================================

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrconnect_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Connection String duoc ASP.NET Core tu dong bind vao builder.Configuration.GetConnectionString("DefaultConnection")
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=HRConnect;Username=postgres;Password=your_secure_password;SearchPath=hr_connect,public

# JWT Authentication
JwtSettings__Secret=YourSuperSecretKeyWithAtLeast32CharactersLong!123456
JwtSettings__Issuer=HRConnect
JwtSettings__Audience=HRConnectApp
JwtSettings__ExpiryMinutes=60
