# ==============================================================================
# HRConnect Environment Configuration Template
# Sao chep file nay thanh `.env` va dien thong tin cau hinh thuc te cua ban
# KHONG commit file `.env` len GitHub!
# ==============================================================================

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# Reverse proxy IP trusted for X-Forwarded-For/X-Forwarded-Proto in production.
# Add more entries with __1, __2, ... when the deployment has multiple proxies.
# ForwardedHeaders__KnownProxies__0=127.0.0.1

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrconnect_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Connection String duoc ASP.NET Core tu dong bind vao builder.Configuration.GetConnectionString("DefaultConnection")
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=HRConnect;Username=postgres;Password=your_secure_password;SearchPath=public

# JWT Authentication
JwtSettings__Secret=YourSuperSecretKeyWithAtLeast32CharactersLong!123456
JwtSettings__Issuer=HRConnect
JwtSettings__Audience=HRConnectApp
JwtSettings__ExpiryMinutes=60

# Resend Email Service Configuration
RESEND_API_KEY=your_resend_api_key
Resend__ApiKey=your_resend_api_key
Resend__FromEmail=no-reply@hrconnectvn.online
Resend__FromName=HR Connect

# Candidate consent page. Production must point this to the deployed frontend.
SUBMISSION_CONSENT_URL_BASE=http://localhost:5173/submission-consent

# ==============================================================================
# Cloudflare R2 Object Storage (Candidate CV Storage)
# ==============================================================================
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
MAX_CV_FILE_SIZE_MB=10

# MF-03 bounded retry/backoff
MF03_BASE_URL=http://127.0.0.1:8001
Mf03Integration__MaxDispatchAttempts=5
Mf03Integration__InitialRetryDelaySeconds=30
Mf03Integration__MaxRetryDelaySeconds=900


