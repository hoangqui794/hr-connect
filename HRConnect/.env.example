# ==============================================================================
# HRConnect Backend (.NET 8) — Environment Configuration Template
# Copy this file to `.env` and fill in your local or deployment credentials.
# NEVER commit `.env` to GitHub!
# ==============================================================================

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# Reverse proxy IP trusted for X-Forwarded-For / X-Forwarded-Proto in production.
# ForwardedHeaders__KnownProxies__0=127.0.0.1

# ==============================================================================
# 1. PostgreSQL 16 Database Configuration
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=HRConnect
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Bound automatically to builder.Configuration.GetConnectionString("DefaultConnection")
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=HRConnect;Username=postgres;Password=your_secure_password;SearchPath=public

# ==============================================================================
# 2. JWT Authentication & CORS
# ==============================================================================
JwtSettings__Secret=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JwtSettings__Issuer=HRConnect
JwtSettings__Audience=HRConnectApp
JwtSettings__ExpiryMinutes=60

# Exact frontend origins allowed to call the API with credentials
Cors__AllowedOrigins__0=http://localhost:5173
# Production example: Cors__AllowedOrigins__0=https://www.hrconnectvn.online

# ==============================================================================
# 3. Resend Transactional Email Service & Candidate Consent URL
# ==============================================================================
RESEND_API_KEY=your_resend_api_key
Resend__ApiKey=your_resend_api_key
Resend__FromEmail=no-reply@hrconnectvn.online
Resend__FromName=HR Connect

# Candidate consent page base URL (Production: https://www.hrconnectvn.online/submission-consent)
SUBMISSION_CONSENT_URL_BASE=http://localhost:5173/submission-consent

# ==============================================================================
# 4. Cloudflare R2 Object Storage (CV PDFs, Signed Agreements, Logos & Avatars)
# ==============================================================================
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=hrconnect-candidate-cvs
R2_ENDPOINT=https://your_r2_account_id_here.r2.cloudflarestorage.com
# Optional public R2/custom-domain URL. Leave empty to serve avatars through the API.
R2_PUBLIC_BASE_URL=
# Public origin of the deployed backend, without /api/v1 (Production: https://api.hrconnectvn.online)
PUBLIC_API_BASE_URL=http://localhost:5041

MAX_CV_FILE_SIZE_MB=10
MAX_CV_PDF_PAGES=30
MAX_AVATAR_FILE_SIZE_MB=5
MAX_COMPANY_LOGO_FILE_SIZE_MB=10
MAX_AVATAR_WIDTH=8192
MAX_AVATAR_HEIGHT=8192
MAX_AVATAR_PIXELS=25000000
AVATAR_OUTPUT_SIZE=1024
AVATAR_WEBP_QUALITY=85
AVATAR_PRESIGNED_URL_EXPIRY_MINUTES=10

# ==============================================================================
# 5. VNPay Online Payment Gateway (Sandbox / Production)
# ==============================================================================
# Sandbox registration: https://sandbox.vnpayment.vn/devreg/
# IPN Webhook URL: https://<backend>/api/v1/payments/vnpay/ipn
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/client/billing/vnpay-return
VNPAY_EXPIRE_MINUTES=15

# ==============================================================================
# 6. AI Matching Service (MF-03) Integration
# ==============================================================================
MF03_BASE_URL=http://127.0.0.1:8001
Mf03Integration__ServiceToken=your_internal_service_token
Mf03Integration__MaxDispatchAttempts=5
Mf03Integration__InitialRetryDelaySeconds=30
Mf03Integration__MaxRetryDelaySeconds=900
