APP_NAME=HR Connect AI Service
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001

EMBEDDING_MODEL=BAAI/bge-m3

# EXPERIMENTAL ONLY - NOT FINAL BUSINESS RULE
MUST_HAVE_WEIGHT=0.50
SHOULD_HAVE_WEIGHT=0.20
SEMANTIC_WEIGHT=0.30
SEMANTIC_MATCH_THRESHOLD=0.65

# CV ingestion and OCR limits
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=40000000
MAX_EXTRACTED_TEXT_CHARS=100000
MAX_DOCX_ENTRIES=2000
MAX_DOCX_UNCOMPRESSED_MB=50
PDF_TEXT_MIN_CHARS_PER_PAGE=30
OCR_LANGUAGES=vi,en
OCR_MAX_CONCURRENCY=1
HRCONNECT_BASE_URL=https://localhost:7289
HRCONNECT_SERVICE_TOKEN=replace-with-a-long-random-secret
SCORING_WORKER_COUNT=1
SCORING_QUEUE_SIZE=2000
INTERNAL_REQUEST_TIMEOUT_SECONDS=30
