APP_NAME=HR Connect AI Service
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# EXPERIMENTAL ONLY - NOT FINAL BUSINESS RULE
MUST_HAVE_WEIGHT=0.50
SHOULD_HAVE_WEIGHT=0.20
SEMANTIC_WEIGHT=0.30
SEMANTIC_MATCH_THRESHOLD=0.35
SEMANTIC_FLOOR=0.10
SEMANTIC_CEILING=0.55

# Semantic partial credit for unresolved OTHER requirements (never MATCHED, always reviewed)
EVIDENCE_CREDIT_THRESHOLD=0.65
EVIDENCE_PARTIAL_CREDIT=0.5
# Optional cross-encoder reranker (~+0.5 GB RAM). Empty = off.
RERANKER_MODEL=
RERANKER_CREDIT_THRESHOLD=0.5
# Empty = app/data/capability_lexicon.json
CAPABILITY_LEXICON_PATH=
# Max score while a MUST_HAVE marked knockout:true is not fully met
KNOCKOUT_SCORE_CAP=59
# Semantic score counts in proportion to MUST_HAVE coverage
SEMANTIC_GATED_BY_MUST_HAVE=true

# CV ingestion and OCR limits
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=40000000
MAX_EXTRACTED_TEXT_CHARS=100000
MAX_DOCX_ENTRIES=2000
MAX_DOCX_UNCOMPRESSED_MB=50
PDF_TEXT_MIN_CHARS_PER_PAGE=30
OCR_LANGUAGES=vi,en
OCR_MAX_CONCURRENCY=1
HRCONNECT_BASE_URL=https://localhost:7289
HRCONNECT_SERVICE_TOKEN=replace-with-a-long-random-secret
HRCONNECT_VERIFY_SSL=true
# Local Swagger/demo only. Production must remain false.
ALLOW_UNAUTHENTICATED_TEST_ENDPOINTS=false
SCORING_WORKER_COUNT=1
SCORING_QUEUE_SIZE=2000
INTERNAL_REQUEST_TIMEOUT_SECONDS=30
