# ==============================================================================
# HRConnect Frontend (React 18 + TypeScript + Vite) — Environment Template
# Copy this file to `.env.local` and adjust if needed.
# ==============================================================================

# Target URL where Vite dev server proxies `/api` and `/hubs` requests in local development
# (5041 = `dotnet run` HTTP profile, 7289 = HTTPS profile, 8080 = Docker container)
VITE_API_PROXY_TARGET=http://localhost:5041

# Full API base URL. Leave empty in local development to use the Vite `/api/v1` proxy above,
# or set explicitly (e.g. http://localhost:5041/api/v1 or https://api.hrconnectvn.online/api/v1).
VITE_API_URL=
