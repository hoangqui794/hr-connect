# Copy to .env.local and adjust if needed. All values are optional in development.

# Where the Vite dev server proxies /api requests.
# 5041 = `dotnet run` http profile, 7289 = https profile, 8080 = Docker image.
VITE_API_PROXY_TARGET=http://localhost:5041

# Full API base URL. Leave empty in development to use the '/api/v1' proxy above.
# Set it for production builds, e.g. https://api.hrconnect.example/api/v1
VITE_API_URL=
