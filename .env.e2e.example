# Copy this file to .env.e2e and replace every placeholder.
# The start script refuses to run unless the database name contains "e2e".
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:7289
Logging__EventLog__LogLevel__Default=None
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=hr_connect_e2e;Username=postgres;Password=replace-me

# One shared secret for HR Connect and the standalone AI service.
HRCONNECT_SERVICE_TOKEN=replace-with-a-long-random-secret
MF03_BASE_URL=http://127.0.0.1:8001
HRCONNECT_BASE_URL=http://127.0.0.1:7289

# Required for the real CV upload/download E2E path.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=replace-me
R2_ENDPOINT=replace-me
MAX_CV_FILE_SIZE_MB=10

# Optional worker tuning.
SCORING_WORKER_COUNT=1
SCORING_QUEUE_SIZE=2000
INTERNAL_REQUEST_TIMEOUT_SECONDS=30
